{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyans-gallery",
  "main": "./src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nyans-gallery-db",
      "database_id": "placeholder-d1-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nyans-gallery-media"
    }
  ],
  "vars": {
    "NYANS_POSTIZ_CHANNEL_ID": ""
  }
}
