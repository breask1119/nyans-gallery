---
// src/layouts/Layout.astro
/**
 * サイト全体の共通レイアウトコンポーネントです。
 * ViewTransitionsによるシームレスな画面遷移と、SEOやSNS向けの動的メタデータを統合しています。
 */
import { ClientRouter } from 'astro:transitions';
import { toAbsoluteUrl } from '../lib/emdash-gallery';
import '../styles/app.scss';

interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
}

// ページごとにプロパティを受け取り、未指定の場合はデフォルト値を使用します。
const { 
  title,
  description = "にゃんずギャラリー",
  image = "/favicon.png",
  url = Astro.site ? Astro.site.toString() : Astro.url.href
} = Astro.props;

const absoluteImageUrl = toAbsoluteUrl(image);
const absolutePageUrl = toAbsoluteUrl(url);
---

<!doctype html>
<html lang="ja" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    
    <!-- モバイル向けのメタ設定です。 -->
    <meta name="theme-color" content="#050505" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="にゃんずギャラリー" />
    
    <!-- ファビコン設定です（PNG形式）。 -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- SEO / OGP / Twitter Cardの設定です。 -->
    <link rel="canonical" href={absolutePageUrl} />
    <meta property="og:site_name" content="にゃんずギャラリー" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={absolutePageUrl} />
    <meta property="og:image" content={absoluteImageUrl} />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />
    
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-[#050505] text-gray-200 antialiased selection:bg-[#F43F5E] selection:text-white">
    <slot />
  </body>
</html>
