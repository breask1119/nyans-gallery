  <!-- COMMENTS MODAL / DRAWER -->
  <dialog id="comment-modal" aria-labelledby="comment-modal-title" class="bg-transparent m-auto p-0 w-full h-full max-w-md backdrop:bg-black/80 overflow-hidden outline-none z-[300] overscroll-contain">
    <div class="bg-[#121218] rounded-3xl border border-white/10 shadow-2xl flex flex-col h-[82vh] max-h-[720px] w-[92%] max-w-sm mx-auto mt-[9vh] overflow-hidden transform scale-95 opacity-0 transition-all duration-300" id="comment-modal-content">
      <div class="p-4 px-6 border-b border-white/5 flex justify-between items-center bg-[#09090d] shrink-0">
        <h3 id="comment-modal-title" class="text-white font-medium text-sm tracking-wide">Comments <span class="text-gray-500 text-xs ml-2" id="modal-comment-count">0</span></h3>
        <button id="btn-close-comment-modal" class="text-gray-400 hover:text-white outline-none transition-colors p-1" aria-label="閉じる">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      
      <div class="flex-1 overflow-y-auto p-5 space-y-4 scroll-smooth overscroll-contain" id="comment-list" aria-live="polite">
        <p class="text-gray-500 font-light text-center py-10">まだコメントはありません。<br/>最初のコメントを投稿しよう！</p>
      </div>

      <div class="p-4 border-t border-white/5 bg-[#09090d] shrink-0 relative pb-[calc(1rem+env(safe-area-inset-bottom))]">
        <div id="reply-indicator" class="hidden absolute top-0 left-4 -translate-y-[calc(100%-1px)] bg-[#121218] border border-white/10 border-b-0 rounded-t-xl px-4 py-1.5 items-center gap-4 z-0 text-xs shadow-lg">
