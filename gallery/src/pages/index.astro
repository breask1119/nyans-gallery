---
// src/pages/index.astro
import { ClientRouter } from 'astro:transitions';
import '../styles/gallery.css';
import '../styles/app.scss';
import { getGalleryData, DEFAULT_WP_GRAPHQL_URL } from '../lib/wp';

// 1. WordPress (WPGraphQL + REST API ハイブリッド) からデータ取得
const { siteInfo, sliders, models: rawModels, latestArtwork, debugLog } = await getGalleryData();

// 画像URLのHTTPS化およびWordPressオリジン正規化ヘルパー
const wpGraphqlUrl = (import.meta.env.PUBLIC_WP_GRAPHQL_URL || DEFAULT_WP_GRAPHQL_URL || '').trim();
const secureUrl = (url: string) => {
  if (!url) return '';
  let httpsUrl = url.replace(/^http:\/\//i, 'https://');
  if (wpGraphqlUrl && !httpsUrl.includes('unsplash.com')) {
    try {
      const wpOrigin = new URL(wpGraphqlUrl).origin;
      const urlObj = new URL(httpsUrl);
      if (urlObj.origin !== wpOrigin) {
        urlObj.protocol = new URL(wpOrigin).protocol;
        urlObj.hostname = new URL(wpOrigin).hostname;
        urlObj.port = new URL(wpOrigin).port;
        return urlObj.toString();
      }
    } catch (e) {}
  }
  return httpsUrl;
};

const placeholderImg = "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1200&auto=format&fit=crop";

const getValidColor = (color: string) => (color && color.trim() !== '') ? color : '#F43F5E';

const hexToRgbString = (hex: string) => {
  const validHex = getValidColor(hex);
  let cleanHex = validHex.replace('#', '');
  if (cleanHex.length === 3) {
    cleanHex = cleanHex.split('').map(c => c + c).join('');
  }
  const r = parseInt(cleanHex.substring(0, 2), 16) || 0;
  const g = parseInt(cleanHex.substring(2, 4), 16) || 0;
  const b = parseInt(cleanHex.substring(4, 6), 16) || 0;
  return `${r}, ${g}, ${b}`;
};

// キャラクター名と英字の対応表（全12モデル対応、表記揺れ対応）
const characterNameMap: Record<string, string> = {
  "美羽": "Miu",
  "美夜": "Miya",
  "美姫": "Miki",
  "美桜": "Mio",
  "美空": "Miku",
  "美玖": "Miku",
  "美英": "Miei",
  "美詠": "Miei",
  "美香": "Mika",
  "美華": "Mika",
  "美緑": "Midori",
  "美鳥": "Midori",
  "未来": "Mirai",
  "美莱": "Mirai",
  "美柚": "Miyuzu",
  "美ゆず": "Miyuzu",
  "美登": "Mito",
  "美豊": "Mito",
  "雪": "Yuki",
  "ユキ": "Yuki",
};

const slugNameMap: Record<string, string> = {
  "miu": "Miu",
  "miya": "Miya",
  "miki": "Miki",
  "mio": "Mio",
  "miku": "Miku",
  "miei": "Miei",
  "mika": "Mika",
  "midori": "Midori",
  "mirai": "Mirai",
  "miyuzu": "Miyuzu",
  "mito": "Mito",
  "yuki": "Yuki",
};

// モデル名を「漢字 / アルファベット (例: 美羽 / Miu)」に整形するヘルパー
const formatModelDisplayName = (name: string, slug?: string) => {
  if (!name) return '';
  const clean = name.trim();
  if (clean.includes('/')) return clean;

  if (characterNameMap[clean]) {
    return `${clean} / ${characterNameMap[clean]}`;
  }

  if (slug) {
    const en = slug.charAt(0).toUpperCase() + slug.slice(1).toLowerCase();
    if (!clean.toLowerCase().includes(slug.toLowerCase())) {
      return `${clean} / ${en}`;
    }
  }

  return clean;
};

// タイトルHTML（漢字とアルファベットを別々のspanにして細身の洗練されたタイポグラフィを適用）
const formatTitleHtml = (displayName: string) => {
  if (!displayName) return '';
  if (displayName.includes(' / ')) {
    const [kanji, romaji] = displayName.split(' / ');
    return `<span class="char-kanji">${kanji}</span><span class="char-divider">/</span><span class="char-romaji">${romaji}</span>`;
  }
  return `<span class="char-kanji">${displayName}</span>`;
};

// キャラクター英名取得ヘルパー（バッジ表示用）
const getRomajiName = (name: string, slug?: string) => {
  if (!name) return 'Miu';
  if (name.includes(' / ')) return name.split(' / ')[1].trim();
  const clean = name.trim();
  if (characterNameMap[clean]) return characterNameMap[clean];
  const lower = clean.toLowerCase();
  if (slugNameMap[lower]) return slugNameMap[lower];
  if (slug && slugNameMap[slug.toLowerCase()]) return slugNameMap[slug.toLowerCase()];
  if (slug && slug !== 'featured') return slug.charAt(0).toUpperCase() + slug.slice(1).toLowerCase();
  return clean.charAt(0).toUpperCase() + clean.slice(1);
};

// WordPressのデータを home-version の 3-Tier UI 用データ構造へ統合変換
// (新方式: artwork_image / 旧方式: variation_images を work.photos に一元化)
const formattedGalleryData = (rawModels && rawModels.length > 0)
  ? rawModels.map((model: any) => {
      const modelId = model.slug || model.id || `model-${Math.random().toString(36).substring(2, 7)}`;
      const displayName = formatModelDisplayName(model.name, model.slug);
      const originalColor = getValidColor(model.memberColor);
      const originalRgb = hexToRgbString(originalColor);
      const avatarSrc = secureUrl(model.modelAvatar?.node?.sourceUrl) || placeholderImg;

      const rawArtworks = model.artworks?.nodes || [];
      const works = rawArtworks.map((art: any, artIdx: number) => {
        const workId = art.slug || art.id || `${modelId}-work-${artIdx + 1}`;
        const dbId = art.databaseId || 0;

        // wp.ts 内で正規化済みの normalizedImages を優先使用
        let photos: any[] = [];
        if (art.normalizedImages && Array.isArray(art.normalizedImages)) {
          photos = art.normalizedImages.map((img: any, pIdx: number) => ({
            id: `${dbId || workId}-${img.id || pIdx}`,
            title: img.title || `${art.title} #${String(pIdx + 1).padStart(2, '0')}`,
            image: secureUrl(img.sourceUrl) || placeholderImg,
            workTitle: art.title,
            modelName: displayName,
            characterId: modelId,
            contentRating: img.contentRating || 'safe',
            sortOrder: img.sortOrder,
            distribution: img.distribution,
          }));
        } else {
          // 旧方式フォールバック
          const cover = secureUrl(art.featuredImage?.node?.sourceUrl) || avatarSrc;
          const varImages = art.orderedImages || art.variationImages?.nodes || [];
          const orderedVarImages = [...varImages].reverse();
          const imgUrls = orderedVarImages.length > 0 ? orderedVarImages.map((v: any) => secureUrl(typeof v === 'string' ? v : v.sourceUrl)) : [cover];
          photos = imgUrls.map((url: string, pIdx: number) => ({
            id: `${dbId || workId}-${pIdx}`,
            title: `${art.title} #${String(pIdx + 1).padStart(2, '0')}`,
            image: url,
            workTitle: art.title,
            modelName: displayName,
            characterId: modelId,
            contentRating: 'safe',
            sortOrder: pIdx + 1,
            distribution: { instagram: true, threads: true, x: true, patreon: 'public' },
          }));
        }

        // 万が一 photos が0件の場合のセーフティネット（カバー画像を1枚目として補充）
        if (photos.length === 0) {
          const fallbackCover = secureUrl(art.featuredImage?.node?.sourceUrl) || avatarSrc;
          photos = [{
            id: `${dbId || workId}-fallback-0`,
            title: art.title,
            image: fallbackCover,
            workTitle: art.title,
            modelName: displayName,
            characterId: modelId,
            contentRating: 'safe',
            sortOrder: 1,
            distribution: { instagram: true, threads: true, x: true, patreon: 'public' },
          }];
        }

        const coverImage = photos.length > 0 ? photos[0].image : (secureUrl(art.featuredImage?.node?.sourceUrl) || avatarSrc);

        return {
          id: workId,
          databaseId: dbId,
          title: art.title,
          slug: art.slug,
          coverImage: coverImage,
          photos: photos,
          likeCount: art.likeCount || 0,
          guestComments: art.guestComments || [],
          promptData: art.promptData || '',
          hasArtworkImages: Boolean(art.hasArtworkImages),

          // AIタグ
          aiSummary: art.aiAnalysis?.summary || '',
          aiTags: Array.isArray(art.aiTags) ? art.aiTags : [],
          aiAnalysis: art.aiAnalysis || null,
          hasAiTags: Boolean(art.hasAiTags),
        };
      });

      return {
        id: modelId,
        dbId: model.id,
        name: displayName,
        rawName: model.name,
        color: originalColor,
        rgb: originalRgb,
        avatar: avatarSrc,
        bio: model.modelBio || '',
        works: works,
      };
    })
  : [];

// 最新投稿（最新作）のアイキャッチ画像・タイトル情報の構築
let latestSlideItem: any = null;

if (latestArtwork) {
  const modelNode = latestArtwork.models?.nodes?.[0];
  const matchedModel = rawModels?.find((m: any) =>
    m.name === modelNode?.name || m.slug === modelNode?.slug
  ) || rawModels?.[0];

  const mName = matchedModel?.name || modelNode?.name || "美羽";
  const mSlug = matchedModel?.slug || modelNode?.slug || "miu";
  const mColor = getValidColor(matchedModel?.memberColor || modelNode?.memberColor);
  const featImg = secureUrl(latestArtwork.featuredImage?.node?.sourceUrl) || placeholderImg;

  latestSlideItem = {
    id: `slider-latest-${latestArtwork.databaseId || latestArtwork.id || 'new'}`,
    title: latestArtwork.title || '最新作',
    workTitle: latestArtwork.title || '最新作',
    image: featImg,
    modelName: formatModelDisplayName(mName, mSlug),
    characterId: mSlug,
    workId: latestArtwork.slug || latestArtwork.title || (latestArtwork.databaseId ? String(latestArtwork.databaseId) : 'latest'),
    color: mColor,
    rgb: hexToRgbString(mColor),
    isLatestPost: true,
  };
} else if (formattedGalleryData.length > 0 && formattedGalleryData[0].works.length > 0) {
  const firstModel = formattedGalleryData[0];
  const firstWork = firstModel.works[0];
  latestSlideItem = {
    id: `slider-latest-${firstWork.databaseId || firstWork.id}`,
    title: firstWork.title,
    workTitle: firstWork.title,
    image: firstWork.coverImage || placeholderImg,
    modelName: firstModel.name,
    characterId: firstModel.id,
    workId: firstWork.id,
    color: firstModel.color,
    rgb: firstModel.rgb,
    isLatestPost: true,
  };
}

// ベースのスライダー用データ（各モデル紹介スライダー）
const baseSliders = (sliders && sliders.length > 0)
  ? sliders.map((s: any, idx: number) => {
      const src = secureUrl(s.featuredImage?.node?.sourceUrl) || placeholderImg;
      const sColor = getValidColor(s.memberColor);
      const matchedModel = rawModels?.find((m: any) => m.name === s.title || m.slug === s.title);
      const displayName = matchedModel
        ? formatModelDisplayName(matchedModel.name, matchedModel.slug)
        : (s.title ? formatModelDisplayName(s.title) : "美羽 / Miu");
      return {
        id: `slider-${idx}`,
        title: s.title || 'Featured',
        image: src,
        workTitle: s.title || 'Featured',
        modelName: displayName,
        characterId: matchedModel?.slug || 'featured',
        color: sColor,
        rgb: hexToRgbString(sColor),
        isLatestPost: false,
      };
    })
  : formattedGalleryData.map((c: any) => {
      const firstWork = c.works[0] || {};
      const firstPhoto = firstWork.photos?.[0] || { id: c.id, title: c.name, image: c.avatar };
      return {
        ...firstPhoto,
        characterId: c.id,
        modelName: c.name,
        workTitle: firstWork.title || c.name,
        color: c.color,
        rgb: c.rgb,
        isLatestPost: false,
      };
    });

// トップ画面の自動スライダー用データ: 1枚目に「最新投稿（アイキャッチ画像＆タイトル）」を確実に配置！
const heroSliderList = latestSlideItem
  ? [latestSlideItem, ...baseSliders]
  : baseSliders;

// 全写真フラット配列（EXPLOREモードおよび全画面モーダル用）
const allPhotosFlat = formattedGalleryData.flatMap((model: any) =>
  model.works.flatMap((work: any) =>
    work.photos.map((photo: any) => ({
      ...photo,
      characterId: model.id,
      modelName: model.name,
      modelColor: model.color,
      modelRgb: model.rgb,
      workId: work.id,
      workTitle: work.title,
      databaseId: work.databaseId,
      aiTags: work.aiTags || [],
      aiSummary: work.aiSummary || '',
      hasAiTags: work.hasAiTags,
    }))
  )
);

// HTMLエンティティデコード
const decodeHtmlEntities = (str: string) => {
  if (!str) return '';
  return str
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#039;/g, "'")
    .replace(/&#8217;/g, '’')
    .replace(/&#8216;/g, '‘');
};

const siteTitle = decodeHtmlEntities(siteInfo?.title) || "Miu's Gallery — Fine Photography & Character Archive";
const siteDescription = decodeHtmlEntities(siteInfo?.description) || "枠にとらわれないダイナミックな写真レイアウトと、各キャラクター作品へのシームレスなアクセス性を追求した次世代フォトギャラリー。";
const siteUrl = Astro.site ? Astro.site.toString() : "https://xx-ai-girls-miu.com/";
const ogImageUrl = heroSliderList[0]?.image || placeholderImg;

const schemaLD = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": siteTitle,
  "description": siteDescription,
  "url": siteUrl,
  "image": ogImageUrl,
  "author": {
    "@type": "Person",
    "name": "Miu"
  }
};

const initialColor = heroSliderList[0]?.color || '#0b0b0b';
const initialRgb = heroSliderList[0]?.rgb || '11, 11, 11';
const initialRgbParts = initialRgb.split(',').map((s: string) => parseInt(s.trim(), 10) || 0);
const initialLuminance = (0.299 * (initialRgbParts[0] || 0) + 0.587 * (initialRgbParts[1] || 0) + 0.114 * (initialRgbParts[2] || 0));
const initialContrastText = initialLuminance > 145 ? '#060608' : '#ffffff';
const initialBorderLight = initialLuminance < 70 ? 'rgba(255, 255, 255, 0.28)' : 'transparent';
---

<!DOCTYPE html>
<html lang="ja" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{siteTitle}</title>
  <meta name="description" content={siteDescription}>
  <link rel="canonical" href={siteUrl}>

  <!-- OGP & Twitter Cards -->
  <meta property="og:site_name" content={siteTitle}>
  <meta property="og:title" content={siteTitle}>
  <meta property="og:description" content={siteDescription}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={siteUrl}>
  <meta property="og:image" content={ogImageUrl}>
  
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={siteTitle}>
  <meta name="twitter:description" content={siteDescription}>
  <meta name="twitter:image" content={ogImageUrl}>

  <!-- PWA & Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#060608">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Miu's Gallery">

  <!-- Fonts (Zen Kaku Gothic New + Outfit + Cinzel + Plus Jakarta Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Noto+Sans+JP:wght@200;300;400;500&family=Outfit:wght@200;300;400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600&family=Zen+Kaku+Gothic+New:wght@300;400;500&display=swap" rel="stylesheet">
  
  <!-- Lucide Icons -->
  <script is:inline src="https://unpkg.com/lucide@latest"></script>
  
  <!-- GSAP CDN -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

  <ClientRouter />

  <!-- PWA Service Worker Registration -->
  <script>
    import { registerSW } from 'virtual:pwa-register';
    if ('serviceWorker' in navigator) {
      registerSW({
        immediate: true
        // 閲覧中の突然の強制リロードによるポップアップ消失を防ぐため、即時リロードは行わない
      });
    }
  </script>

  <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
  <script is:inline>
    window.OneSignalDeferred = window.OneSignalDeferred || [];
    OneSignalDeferred.push(async function(OneSignal) {
      if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
        return;
      }
      await OneSignal.init({
        appId: "06418ce1-102a-4a7b-a88b-069b594cf919",
        serviceWorkerPath: "push/onesignal/OneSignalSDKWorker.js",
        serviceWorkerParam: {
          scope: "/push/onesignal/"
        },
        promptOptions: {
          slidedown: {
            prompts: [
              {
                type: "push",
                autoPrompt: true,
                text: {
                  actionMessage: "新しいギャラリーが追加されたら通知を受け取りますか？",
                  acceptButton: "受け取る",
                  cancelButton: "あとで",
                },
                delay: {
                  pageViews: 1,
                  timeDelay: 5 
                }
              }
            ]
          }
        }
      });
    });
  </script>

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaLD)} />

  <script define:vars={{ wpGraphqlUrl }}>
    window.WP_GRAPHQL_URL = wpGraphqlUrl;
  </script>

  <!-- Immediate beforeinstallprompt capture -->
  <script is:inline>
    window.__deferredPwaPrompt = null;
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      window.__deferredPwaPrompt = e;
      if (typeof window.__triggerPwaPrompt === 'function') {
        window.__triggerPwaPrompt();
      }
    });
  </script>

  <style is:inline define:vars={{ initialColor, initialRgb, initialContrastText, initialBorderLight }}>
    :root {
      --char-accent: var(--initialColor);
      --char-rgb: var(--initialRgb);
      --char-accent-rgb: var(--initialRgb);
      --char-glow: rgba(var(--initialRgb), 0.35);
      --char-accent-text: var(--initialContrastText);
      --char-accent-border: var(--initialBorderLight);
    }
  </style>
</head>
<body class="bg-base text-slate-100 selection:bg-rose-500 selection:text-white">

  <!-- Lightweight Dynamic Ambient Background (GPU Accelerated) -->
  <div id="ambient-aura-layer" class="ambient-aura-layer" aria-hidden="true"></div>

  <!-- Interactive Custom Cursor (PC fine pointer only) -->
  <div id="custom-cursor" class="custom-cursor" aria-hidden="true">
    <div class="cursor-dot"></div>
    <div class="cursor-ring"></div>
    <span class="cursor-label">EXPAND</span>
  </div>

  <!-- Floating Top Bar: Logo, Social Links & About Button -->
