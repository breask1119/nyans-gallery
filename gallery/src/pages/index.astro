  <!-- APP CLIENT-SIDE INTERACTION SCRIPT -->
  <script is:inline>
    (function() {
      // データの取得
      const dataScript = document.getElementById('app-gallery-data');
      if (!dataScript) return;
      const { galleryData, heroSliderList, allPhotosFlat } = JSON.parse(dataScript.textContent);

      // アプリケーション状態
      let currentModelId = galleryData[0]?.id || '';
      let currentWorkId = galleryData[0]?.works?.[0]?.id || '';
      let currentWork = galleryData[0]?.works?.[0] || null;
      let currentPhotosInWork = [];
      let currentPhotoIndex = 0;

      let isHeroSliderActive = false;
      let heroSliderIndex = 0;
      let heroSliderTimer = null;

      // モーダル・ズーム・ジェスチャー状態
      let modalPhotoIndex = 0;
      let modalFilteredList = [...allPhotosFlat];
      let currentScale = 1;
      let currentPanX = 0;
      let currentPanY = 0;
      let startPinchDist = 0;
      let startScale = 1;
      let touchStartX = 0;
      let touchStartY = 0;
      let startPanX = 0;
      let startPanY = 0;
      let isPinching = false;
      let isPanning = false;
      let lastTapTime = 0;
      let swipeHintTimeout = null;

      // コメント関連状態
      let activeReplyId = 0;
      const commentModal = document.getElementById('comment-modal');
      const commentModalContent = document.getElementById('comment-modal-content');
      const commentList = document.getElementById('comment-list');
      const commentAuthorInput = document.getElementById('comment-author');
      const commentContentInput = document.getElementById('comment-content');
      const commentSubmitBtn = document.getElementById('comment-submit-btn');

      // DOM 要素
      const modal = document.getElementById('cinematic-modal');
      const modalImg = document.getElementById('modal-img');
      const modalTitle = document.getElementById('modal-photo-title');
      const modalModel = document.getElementById('modal-photo-model');
      const modalBadge = document.getElementById('modal-cat-badge');
      const modalCloseBtn = document.getElementById('modal-close-btn');
      const modalNextBtn = document.getElementById('modal-next-btn');
      const modalPrevBtn = document.getElementById('modal-prev-btn');
      const modalBackdrop = document.getElementById('modal-backdrop-blur');
      const swipeHintEl = document.getElementById('modal-swipe-hint');
      const imageHolder = document.getElementById('modal-image-holder');

      function formatTitleHtml(displayName) {
        if (!displayName) return '';
        if (displayName.includes(' / ')) {
          const parts = displayName.split(' / ');
          return `<span class="char-kanji">${parts[0]}</span><span class="char-divider">/</span><span class="char-romaji">${parts[1]}</span>`;
        }
        return `<span class="char-kanji">${displayName}</span>`;
      }

      const clientCharNameMap = {
        "美羽": "Miu",
        "美夜": "Miya",
        "美姫": "Miki",
        "美桜": "Mio",
        "美空": "Miku",
        "美玖": "Miku",
        "美英": "Miei",
        "美詠": "Miei",
        "美香": "Mika",
        "美華": "Mika",
        "美緑": "Midori",
        "美鳥": "Midori",
        "未来": "Mirai",
        "美莱": "Mirai",
        "美柚": "Miyuzu",
        "美ゆず": "Miyuzu",
        "美登": "Mito",
        "美豊": "Mito",
        "雪": "Yuki",
        "ユキ": "Yuki"
      };

      const clientSlugNameMap = {
        "miu": "Miu",
        "miya": "Miya",
        "miki": "Miki",
        "mio": "Mio",
        "miku": "Miku",
        "miei": "Miei",
        "mika": "Mika",
        "midori": "Midori",
        "mirai": "Mirai",
        "miyuzu": "Miyuzu",
        "mito": "Mito",
        "yuki": "Yuki"
      };

      function getRomajiName(displayName, slug) {
        if (!displayName) return 'Miu';
        if (displayName.includes(' / ')) {
          return displayName.split(' / ')[1].trim();
        }
        const clean = displayName.trim();
        if (clientCharNameMap[clean]) {
          return clientCharNameMap[clean];
        }
        const lower = clean.toLowerCase();
        if (clientSlugNameMap[lower]) {
          return clientSlugNameMap[lower];
        }
        if (slug && clientSlugNameMap[slug.toLowerCase()]) {
          return clientSlugNameMap[slug.toLowerCase()];
        }
        if (slug && slug !== 'featured') {
          return slug.charAt(0).toUpperCase() + slug.slice(1).toLowerCase();
        }
        return clean.charAt(0).toUpperCase() + clean.slice(1);
      }

      // ============================================================
      // PWA INSTALL PROMPT (Mobile & iOS & Desktop)
      // ============================================================
      function initPwaPrompt() {
        const promptEl = document.getElementById('pwa-install-prompt');
        if (!promptEl) return;

        const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (window.navigator && window.navigator.standalone);
        const urlParams = new URLSearchParams(window.location.search);
        const forcePwa = urlParams.has('pwa');

        const headerBtn = document.getElementById('header-pwa-btn');
        const aboutInstallBtn = document.getElementById('about-pwa-btn');

        // すでにネイティブアプリとしてインストール・起動中の場合はボタン類を非表示
        if (isStandalone) {
          if (headerBtn) headerBtn.style.display = 'none';
          if (aboutInstallBtn) aboutInstallBtn.style.display = 'none';
          return;
        }

        const DISMISS_KEY = 'miu_pwa_dismiss_until';
        // 過去の永久非表示キーを削除してリセット
        localStorage.removeItem('miu_pwa_prompt_closed');

        const dismissUntil = parseInt(localStorage.getItem(DISMISS_KEY) || '0', 10);
        const isDismissed = !forcePwa && (Date.now() < dismissUntil);

        const iosInstructions = document.getElementById('pwa-ios-instructions');
        const manualInstructions = document.getElementById('pwa-manual-instructions');
        const installBtn = document.getElementById('pwa-install-btn');
        const closeBtn = document.getElementById('pwa-close-btn');

        const userAgent = window.navigator.userAgent.toLowerCase();
        const isIOS = /iphone|ipad|ipod/.test(userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

        const showPrompt = (isManual = false) => {
          if (!isManual && isDismissed) {
            return;
          }

          const prompt = window.__deferredPwaPrompt;
          if (prompt) {
            // Android Chrome等でbeforeinstallpromptが取れた場合（ワンタップボタン）
            if (installBtn) installBtn.classList.remove('hidden');
            if (manualInstructions) manualInstructions.classList.add('hidden');
            if (iosInstructions) iosInstructions.classList.add('hidden');
          } else if (isIOS) {
            // iPhone / iPad（Safari共有ボタン案内）
            if (iosInstructions) iosInstructions.classList.remove('hidden');
            if (manualInstructions) manualInstructions.classList.add('hidden');
            if (installBtn) installBtn.classList.add('hidden');
          } else {
            // その他（手動メニュー追加案内）
            if (manualInstructions) manualInstructions.classList.remove('hidden');
            if (iosInstructions) iosInstructions.classList.add('hidden');
            if (installBtn) installBtn.classList.add('hidden');
          }

          promptEl.classList.add('is-visible');
        };

        const hidePrompt = (persistDismiss = true) => {
          promptEl.classList.remove('is-visible');
          if (persistDismiss) {
            // 閉じた場合は12時間自動ポップアップを抑制
            localStorage.setItem(DISMISS_KEY, (Date.now() + 12 * 60 * 60 * 1000).toString());
          }
        };

        window.__triggerPwaPrompt = (manual = false) => showPrompt(manual);

        // ヘッダーボタン・Aboutモーダル内のボタンから手動表示
        headerBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          showPrompt(true);
        });

        aboutInstallBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          const infoModal = document.getElementById('info-modal');
          if (infoModal && typeof infoModal.close === 'function') {
            infoModal.close();
          }
          showPrompt(true);
        });

        // 自動表示（未閉鎖時または?pwa指定時）
        if (!isDismissed || forcePwa) {
          if (window.__deferredPwaPrompt) {
            setTimeout(() => showPrompt(false), 1200);
          } else {
            setTimeout(() => showPrompt(false), 1800);
          }
        }

        closeBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          hidePrompt(true);
        });

        installBtn?.addEventListener('click', async (e) => {
          e.stopPropagation();
          const prompt = window.__deferredPwaPrompt;
          if (prompt) {
            prompt.prompt();
            const { outcome } = await prompt.userChoice;
            if (outcome === 'accepted') {
              hidePrompt(true);
            }
            window.__deferredPwaPrompt = null;
          }
        });
      }

      // ============================================================
      // SCROLL-TRIGGERED FLOATING HEADER
      // ============================================================
      function checkTopBarVisibility() {
        const topBar = document.getElementById('floating-top-bar');
        if (!topBar) return;

        const isSubpage = document.body.classList.contains('is-subpage');
        const scrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
        const panelScrollY = document.getElementById('side-content-panel')?.scrollTop || 0;

        // サブページ表示中、または30px以上スクロールした時に表示
        if (scrollY > 30 || panelScrollY > 30 || isSubpage) {
          topBar.classList.add('is-visible');
        } else {
          topBar.classList.remove('is-visible');
        }
      }

      function initScrollHeader() {
        window.addEventListener('scroll', checkTopBarVisibility, { passive: true });
        document.getElementById('side-content-panel')?.addEventListener('scroll', checkTopBarVisibility, { passive: true });
        checkTopBarVisibility();
      }

      function initApp() {
        bindCharactersViewEvents();
        initFloatingDock();
        initStageControls();
        initModal();
        initCustomCursor();
        init3DTilt();
        initKeyboardShortcuts();
        initAboutModal();
        initLikesAndComments();
        initPwaPrompt();
        initExploreMode();
        initScrollHeader();

        // 初期表示: ホーム画面（Hero Slider開始）
        showCharactersView();

        // PC: メインビジュアル上でホイールした際にサイドパネルをスクロール
        const stage = document.getElementById('main-visual-stage');
        stage?.addEventListener('wheel', (e) => {
          if (window.innerWidth > 960) {
            const activePanel = document.querySelector('.panel-view-section.active');
            if (activePanel) {
              activePanel.scrollTop += e.deltaY;
            }
          }
        }, { passive: true });

        // ブランドロゴクリックでトップ（モデル一覧）へ戻る
        document.getElementById('brand-home-link')?.addEventListener('click', (e) => {
          e.preventDefault();
          showCharactersView();
        });

        // 戻るボタン
        document.getElementById('btn-back-to-characters')?.addEventListener('click', () => {
          showCharactersView();
        });

        document.getElementById('btn-back-to-works')?.addEventListener('click', () => {
          showWorksView(currentModelId);
        });

        // メインビジュアルクリック処理
        document.getElementById('stage-photo-wrapper')?.addEventListener('click', () => {
          if (isHeroSliderActive || !document.body.classList.contains('is-subpage')) {
            // トップページでスライダー動作中の場合
            const currentSlide = heroSliderList[heroSliderIndex];
            if (currentSlide?.isLatestPost && currentSlide?.workId && currentSlide?.characterId) {
              // 最新作スライドの場合：モデル作品一覧を開いた上で、その作品アルバムを直接展開！
              showWorksView(currentSlide.characterId);
              showPhotosView(currentSlide.workId);
            } else if (currentSlide?.characterId && currentSlide.characterId !== 'featured') {
              showWorksView(currentSlide.characterId);
            } else if (galleryData[0]?.id) {
              showWorksView(galleryData[0].id);
            }
            return;
          }
          // 作品詳細時：高精細モーダルを展開
          const activePhoto = currentPhotosInWork[currentPhotoIndex];
          if (activePhoto) openModal(activePhoto.id);
        });

        // Lucide Icons 再生成
        if (window.lucide) {
          window.lucide.createIcons();
        }
      }

      // ============================================================
      // TIER 1: CHARACTERS VIEW
      // ============================================================
      function bindCharactersViewEvents() {
        const container = document.getElementById('characters-grid-list');
        if (!container) return;

        container.querySelectorAll('.char-select-card').forEach(card => {
          card.addEventListener('click', () => {
            const cid = card.getAttribute('data-char-id');
            if (cid) showWorksView(cid);
          });
        });
      }

      function showCharactersView() {
        switchPanelView('view-characters');
        startHeroSlider();
      }

      // ============================================================
      // TIER 2: WORKS / ALBUMS LIST VIEW
      // ============================================================
      function showWorksView(modelId) {
        stopHeroSlider();
        currentModelId = modelId;
        const model = galleryData.find(c => c.id === modelId) || galleryData[0];
        if (!model) return;

        morphCharacterColor(model.color, model.rgb);
        switchPanelView('view-works');
        updateFloatingDockActive(modelId);

        // メインステージのバッジ反映
        const stageColorChip = document.getElementById('stage-color-chip');
        if (stageColorChip) stageColorChip.style.backgroundColor = model.color;
        const stageBadgeName = document.getElementById('stage-badge-name');
        if (stageBadgeName) stageBadgeName.textContent = getRomajiName(model.name, model.id);

        // モデル概要カード更新
        const modelNameEl = document.getElementById('active-model-name');
        if (modelNameEl) modelNameEl.innerHTML = formatTitleHtml(model.name);
        const worksCountEl = document.getElementById('active-model-works-count');
        if (worksCountEl) worksCountEl.textContent = `${model.works.length} Works`;
        const avatarEl = document.getElementById('active-model-avatar');
        if (avatarEl) avatarEl.src = model.avatar;
        const bioSectionEl = document.getElementById('active-model-bio-section');
        const bioEl = document.getElementById('active-model-bio');
        if (bioEl) {
          if (model.bio && model.bio.trim() !== '') {
            bioEl.innerHTML = model.bio;
            if (bioSectionEl) bioSectionEl.style.display = 'block';
          } else {
            bioEl.innerHTML = '';
            if (bioSectionEl) bioSectionEl.style.display = 'none';
          }
        }

        // 作品アルバム一覧をレンダリング
        const worksContainer = document.getElementById('works-albums-list');
        if (worksContainer) {
          worksContainer.innerHTML = model.works.map(w => {
            const displayTags = Array.isArray(w.aiTags)
              ? w.aiTags.slice(0, 4)
              : [];

            const tagsHtml = displayTags.length > 0
              ? `
                <div class="work-ai-tags">
                  ${displayTags.map(tag => `
                    <span class="work-ai-tag">${tag}</span>
                  `).join('')}
                </div>
              `
              : '';

            return `
              <button class="work-album-card" data-work-id="${w.id}" aria-label="${w.title} の写真を閲覧">
                <div class="work-album-cover">
                  <img src="${w.coverImage}" alt="${w.title}" loading="lazy" referrerpolicy="no-referrer">
                </div>
                <div class="work-album-info">
                  <h4 class="work-album-title">${w.title}</h4>
                  <div class="work-album-meta">
                    <span class="work-photos-badge">${w.photos.length} Photos</span>
                  </div>
                  ${tagsHtml}
                </div>
              </button>
            `;
          }).join('');

          worksContainer.querySelectorAll('.work-album-card').forEach(card => {
            card.addEventListener('click', () => {
              const wid = card.getAttribute('data-work-id');
              if (wid) showPhotosView(wid);
            });
          });
        }

        // 最初の作品の最初の写真をメインステージに表示
        if (model.works.length > 0) {
          const firstWork = model.works[0];
          currentWorkId = firstWork.id;
          currentWork = firstWork;
          currentPhotosInWork = firstWork.photos.map(p => ({
            ...p,
            characterId: model.id,
            modelName: model.name,
            workTitle: firstWork.title,
            databaseId: firstWork.databaseId,
          }));
          currentPhotoIndex = 0;
          updateModalFilteredList(currentPhotosInWork);
          setMainStagePhoto(currentPhotosInWork[0], firstWork, model);
        }

        if (window.rebindCursorHovers) window.rebindCursorHovers();
      }

      // ============================================================
      // TIER 3: PHOTOS THUMBNAILS GRID VIEW (INSIDE WORK)
      // ============================================================
      function showPhotosView(workId) {
        currentWorkId = workId;
        const model = galleryData.find(c => c.id === currentModelId) || galleryData[0];
        if (!model) return;
        const work = model.works.find(w => w.id === workId) || model.works[0];
        if (!work) return;

        currentWork = work;

        switchPanelView('view-photos');
        updateFloatingDockActive(currentModelId);

        // 作品概要カード更新
        const workTitleEl = document.getElementById('active-work-title');
        if (workTitleEl) workTitleEl.textContent = work.title;
        const photosCountEl = document.getElementById('active-work-photos-count');
        if (photosCountEl) photosCountEl.textContent = `${work.photos.length} Photos`;
        const backLabel = document.getElementById('btn-back-works-label');
        if (backLabel) backLabel.textContent = `${model.name.split(' ')[0]}'S WORKS`;

        // いいね・コメント状態の更新
        updateWorkStatsUI();
        if (work.databaseId) {
          fetchLiveStats(work.databaseId);
        }

        currentPhotosInWork = work.photos.map(p => ({
          ...p,
          characterId: model.id,
          modelName: model.name,
          workTitle: work.title,
          databaseId: work.databaseId,
        }));

        currentPhotoIndex = 0;
        updateModalFilteredList(currentPhotosInWork);

        // サムネイルグリッドの描画
        const thumbsGrid = document.getElementById('photos-thumbnails-grid');
        if (thumbsGrid) {
          thumbsGrid.innerHTML = currentPhotosInWork.map((p, index) => `
            <button class="photo-thumb-btn ${index === currentPhotoIndex ? 'active' : ''}" data-index="${index}" aria-label="${p.title}">
              <img src="${p.image}" alt="${p.title}" loading="lazy" referrerpolicy="no-referrer">
              <div class="photo-thumb-caption">${p.title}</div>
            </button>
          `).join('');

          thumbsGrid.querySelectorAll('.photo-thumb-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const idx = parseInt(btn.getAttribute('data-index'), 10);
              selectPhotoInWork(idx, work, model);
            });
          });
        }

        if (currentPhotosInWork.length > 0) {
          setMainStagePhoto(currentPhotosInWork[0], work, model);
        }

        if (window.rebindCursorHovers) window.rebindCursorHovers();
      }

      function selectPhotoInWork(index, work, model) {
        currentPhotoIndex = index;
        document.querySelectorAll('.photo-thumb-btn').forEach((btn, i) => {
          btn.classList.toggle('active', i === currentPhotoIndex);
        });
        setMainStagePhoto(currentPhotosInWork[index], work, model);
      }

      // パネルビュー切り替え
      function switchPanelView(viewId) {
        ['view-characters', 'view-works', 'view-photos'].forEach(id => {
          document.getElementById(id)?.classList.toggle('active', id === viewId);
        });

        const isSubpage = (viewId === 'view-works' || viewId === 'view-photos');
        const isPhotosView = (viewId === 'view-photos');

        document.body.classList.toggle('is-subpage', isSubpage);
        document.body.classList.toggle('is-photos-view', isPhotosView);

        // スマホでは画面全体のスクロール位置を最上部（Y = 0）に確実にリセット
        // これにより、どのキャラクターをスクロールしてタップしても画面が下へズレずに統一して表示される
        if (window.innerWidth <= 960) {
          window.scrollTo({ top: 0, behavior: 'instant' });
        } else {
          const sidePanel = document.getElementById('side-content-panel');
          if (sidePanel) sidePanel.scrollTop = 0;
        }

        const targetView = document.getElementById(viewId);
        if (targetView) targetView.scrollTop = 0;

        document.getElementById('character-floating-dock')?.classList.toggle('visible', isSubpage);
        document.getElementById('side-content-panel')?.classList.toggle('has-floating-dock', isSubpage);

        // ヘッダーのスクロール可視状態を再判定
        checkTopBarVisibility();
      }

      // ============================================================
      // MAIN STAGE PHOTO CONTROLLER
      // ============================================================
      function updateExpandPromptLabel(isSlider, customLabel) {
        const pcText = document.querySelector('.photo-expand-prompt .pc-text');
        const spText = document.querySelector('.photo-expand-prompt .sp-text');
        if (customLabel) {
          if (pcText) pcText.textContent = `CLICK TO ${customLabel}`;
          if (spText) spText.textContent = `TAP TO ${customLabel}`;
        } else if (isSlider) {
          if (pcText) pcText.textContent = 'CLICK TO VIEW ALBUM';
          if (spText) spText.textContent = 'TAP TO VIEW ALBUM';
        } else {
          if (pcText) pcText.textContent = 'CLICK TO EXPAND';
          if (spText) spText.textContent = 'TAP TO EXPAND';
        }
      }

      function setMainStagePhoto(photo, work, model) {
        if (!photo) return;

        updateExpandPromptLabel(false);

        const mainImg = document.getElementById('main-stage-img');
        const blurImg = document.getElementById('stage-blur-img');

        if (!mainImg) return;

        mainImg.style.opacity = '0.3';
        mainImg.style.transform = 'scale(0.98)';

        setTimeout(() => {
          mainImg.src = photo.image;
          if (blurImg) blurImg.src = photo.image;

          const stageColorChip = document.getElementById('stage-color-chip');
          if (stageColorChip && model) {
            stageColorChip.style.backgroundColor = model.color;
          }
          const stageBadgeName = document.getElementById('stage-badge-name');
          if (stageBadgeName && model) {
            stageBadgeName.textContent = getRomajiName(model.name, model.id);
          }

          mainImg.style.opacity = '1';
          mainImg.style.transform = 'scale(1)';
        }, 100);
      }

      function initStageControls() {
        function goPrev() {
          if (isHeroSliderActive) {
            prevHeroSlide();
            return;
          }
          if (currentPhotosInWork.length <= 1) return;
          currentPhotoIndex = (currentPhotoIndex - 1 + currentPhotosInWork.length) % currentPhotosInWork.length;
          updatePhotoSelection();
        }

        function goNext() {
          if (isHeroSliderActive) {
            nextHeroSlide();
            return;
          }
          if (currentPhotosInWork.length <= 1) return;
          currentPhotoIndex = (currentPhotoIndex + 1) % currentPhotosInWork.length;
          updatePhotoSelection();
        }

        function updatePhotoSelection() {
          document.querySelectorAll('.photo-thumb-btn').forEach((btn, i) => {
            btn.classList.toggle('active', i === currentPhotoIndex);
          });
          const model = galleryData.find(c => c.id === currentModelId);
          const work = model?.works.find(w => w.id === currentWorkId);
          setMainStagePhoto(currentPhotosInWork[currentPhotoIndex], work, model);
        }

        // モバイルタッチスワイプ
        const stage = document.getElementById('main-visual-stage');
        if (stage) {
          let touchStartX = 0;
          let touchEndX = 0;

          stage.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
          }, { passive: true });

          stage.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            const diff = touchEndX - touchStartX;
            if (Math.abs(diff) > 45) {
              if (diff > 0) goPrev();
              else goNext();
            }
          }, { passive: true });
        }
      }

      // ============================================================
      // HERO SLIDER (トップページ自動スライダー)
      // ============================================================
      function startHeroSlider() {
        isHeroSliderActive = true;
        updateModalFilteredList(heroSliderList);

        const dotsContainer = document.getElementById('stage-slider-dots');
        if (dotsContainer) {
          dotsContainer.classList.add('active');
          dotsContainer.innerHTML = heroSliderList.map((item, idx) => `
            <button class="slider-dot ${idx === heroSliderIndex ? 'active' : ''}" data-idx="${idx}" aria-label="${item.modelName} のスライドへ"></button>
          `).join('');

          dotsContainer.querySelectorAll('.slider-dot').forEach(dot => {
            dot.addEventListener('click', (e) => {
              e.stopPropagation();
              const idx = parseInt(dot.getAttribute('data-idx'), 10);
              const dir = idx >= heroSliderIndex ? 1 : -1;
              renderHeroSlide(idx, dir);
              restartHeroSliderTimer();
            });
          });
        }

        renderHeroSlide(heroSliderIndex);
        restartHeroSliderTimer();
      }

      function stopHeroSlider() {
        isHeroSliderActive = false;
        if (heroSliderTimer) {
          clearInterval(heroSliderTimer);
          heroSliderTimer = null;
        }
        const dotsContainer = document.getElementById('stage-slider-dots');
        if (dotsContainer) {
          dotsContainer.classList.remove('active');
        }
      }

      function restartHeroSliderTimer() {
        if (heroSliderTimer) clearInterval(heroSliderTimer);
        heroSliderTimer = setInterval(() => {
          if (isHeroSliderActive) {
            nextHeroSlide();
          }
        }, 5200);
      }

      function nextHeroSlide() {
        if (!heroSliderList || heroSliderList.length === 0) return;
        const nextIdx = (heroSliderIndex + 1) % heroSliderList.length;
        renderHeroSlide(nextIdx, 1);
      }

      function prevHeroSlide() {
        if (!heroSliderList || heroSliderList.length === 0) return;
        const prevIdx = (heroSliderIndex - 1 + heroSliderList.length) % heroSliderList.length;
        renderHeroSlide(prevIdx, -1);
      }

      function renderHeroSlide(index, direction = 1) {
        if (!heroSliderList || heroSliderList.length === 0) return;
        heroSliderIndex = index;

        const currentSlide = heroSliderList[heroSliderIndex];
        const mainImg = document.getElementById('main-stage-img');
        const blurImg = document.getElementById('stage-blur-img');
        const stageColorChip = document.getElementById('stage-color-chip');
        const stageBadgeName = document.getElementById('stage-badge-name');

        if (stageColorChip) stageColorChip.style.backgroundColor = currentSlide.color;

        if (currentSlide.isLatestPost) {
          const charName = getRomajiName(currentSlide.modelName, currentSlide.characterId);
          if (stageBadgeName) stageBadgeName.textContent = `NEW: ${currentSlide.title} (${charName})`;
          updateExpandPromptLabel(true, `VIEW "${currentSlide.title}"`);
        } else {
          if (stageBadgeName) stageBadgeName.textContent = getRomajiName(currentSlide.modelName, currentSlide.characterId);
          updateExpandPromptLabel(true);
        }

        document.querySelectorAll('.stage-slider-dots .slider-dot').forEach((dot, i) => {
          dot.classList.toggle('active', i === heroSliderIndex);
        });

        morphCharacterColor(currentSlide.color, currentSlide.rgb);

        if (mainImg) {
          mainImg.style.opacity = '0.3';
          mainImg.style.transform = `scale(0.97) translateX(${direction * 8}px)`;

          setTimeout(() => {
            mainImg.src = currentSlide.image;
            if (blurImg) blurImg.src = currentSlide.image;
            mainImg.style.opacity = '1';
            mainImg.style.transform = 'scale(1) translateX(0px)';
          }, 140);
        }
      }

      // ============================================================
      // FLOATING CHARACTER DOCK
      // ============================================================
      function initFloatingDock() {
        const dockInner = document.getElementById('dock-inner');
        if (!dockInner) return;

        dockInner.innerHTML = galleryData.map(c => `
          <button class="dock-item-btn" data-char-id="${c.id}" aria-label="${c.name}">
            <img src="${c.avatar}" alt="${c.name}" loading="lazy">
          </button>
        `).join('');

        dockInner.querySelectorAll('.dock-item-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const cid = btn.getAttribute('data-char-id');
            if (cid) showWorksView(cid);
          });
        });
      }

      function updateFloatingDockActive(modelId) {
        document.querySelectorAll('.dock-item-btn').forEach(btn => {
          btn.classList.toggle('active', btn.getAttribute('data-char-id') === modelId);
        });
      }

      // ============================================================
      // DYNAMIC COLOR MORPHING
      // ============================================================
      function morphCharacterColor(hex, rgb) {
        if (!hex || !rgb) return;
        document.documentElement.style.setProperty('--char-accent', hex);
        document.documentElement.style.setProperty('--char-rgb', rgb);
        document.documentElement.style.setProperty('--char-accent-rgb', rgb);
        document.documentElement.style.setProperty('--char-glow', `rgba(${rgb}, 0.35)`);

        // RGBから輝度を計算して文字色（白/黒）と輪郭ボーダーを自動設定
        const parts = rgb.split(',').map(s => parseInt(s.trim(), 10) || 0);
        const r = parts[0] || 0, g = parts[1] || 0, b = parts[2] || 0;
        const luminance = (0.299 * r + 0.587 * g + 0.114 * b);
        const contrastText = luminance > 145 ? '#060608' : '#ffffff';
        const borderLight = luminance < 70 ? 'rgba(255, 255, 255, 0.28)' : 'transparent';
        document.documentElement.style.setProperty('--char-accent-text', contrastText);
        document.documentElement.style.setProperty('--char-accent-border', borderLight);
      }

      // ============================================================
      // CINEMATIC FULLSCREEN LIGHTBOX MODAL
      // ============================================================
      function updateModalFilteredList(newList) {
        modalFilteredList = [...newList];
      }

      function openModal(photoId) {
        if (!modal) return;
        const targetIdx = modalFilteredList.findIndex(p => p.id === photoId);
        modalPhotoIndex = targetIdx !== -1 ? targetIdx : 0;

        resetZoom();
        renderModalContent();
        modal.showModal();
        document.body.style.overflow = 'hidden';

        showSwipeHintFirstTime();
      }

      function closeModal() {
        if (!modal) return;
        modal.close();
        document.body.style.overflow = '';
        resetZoom();
      }

      function renderModalContent() {
        const photo = modalFilteredList[modalPhotoIndex];
        if (!photo) return;

        if (modalImg) {
          modalImg.src = photo.image;
        }
        if (modalTitle) modalTitle.textContent = photo.title || photo.workTitle || '';
        if (modalModel) modalModel.textContent = photo.modelName || '';
        if (modalBadge) modalBadge.textContent = photo.characterId ? photo.characterId.toUpperCase() : 'PHOTO';

        updateModalLikeButton();
      }

      function nextModalPhoto() {
        if (modalFilteredList.length <= 1) return;
        modalPhotoIndex = (modalPhotoIndex + 1) % modalFilteredList.length;
        resetZoom();
        renderModalContent();
      }

      function prevModalPhoto() {
        if (modalFilteredList.length <= 1) return;
        modalPhotoIndex = (modalPhotoIndex - 1 + modalFilteredList.length) % modalFilteredList.length;
        resetZoom();
        renderModalContent();
      }

      function resetZoom() {
        currentScale = 1;
        currentPanX = 0;
        currentPanY = 0;
        applyTransform();
      }

      function applyTransform() {
        if (modalImg) {
          modalImg.style.transform = `translate3d(${currentPanX}px, ${currentPanY}px, 0) scale(${currentScale})`;
        }
      }

      function showSwipeHintFirstTime() {
        if (!swipeHintEl) return;
        const seen = localStorage.getItem('miu_swipe_hint_seen');
        if (!seen && window.innerWidth <= 960) {
          swipeHintEl.style.display = 'block';
          swipeHintTimeout = setTimeout(() => {
            swipeHintEl.style.display = 'none';
            localStorage.setItem('miu_swipe_hint_seen', 'true');
          }, 3500);
        }
      }

      function initModal() {
        modalCloseBtn?.addEventListener('click', closeModal);
        modalNextBtn?.addEventListener('click', nextModalPhoto);
        modalPrevBtn?.addEventListener('click', prevModalPhoto);
        modalBackdrop?.addEventListener('click', closeModal);

        // キーボード操作
        modal?.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeModal();
          if (e.key === 'ArrowRight') nextModalPhoto();
          if (e.key === 'ArrowLeft') prevModalPhoto();
        });

        // ピンチズーム & パン & スワイプ
        if (imageHolder) {
          imageHolder.addEventListener('touchstart', handleTouchStart, { passive: false });
          imageHolder.addEventListener('touchmove', handleTouchMove, { passive: false });
          imageHolder.addEventListener('touchend', handleTouchEnd, { passive: true });
        }

        // ダブルタップズーム
        modalImg?.addEventListener('click', (e) => {
          const now = Date.now();
          if (now - lastTapTime < 300) {
            e.preventDefault();
            if (currentScale > 1) {
              resetZoom();
            } else {
              currentScale = 2.4;
              applyTransform();
            }
          }
          lastTapTime = now;
        });
      }

      function handleTouchStart(e) {
        if (e.touches.length === 2) {
          isPinching = true;
          startPinchDist = getDistance(e.touches[0], e.touches[1]);
          startScale = currentScale;
        } else if (e.touches.length === 1) {
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
          startPanX = currentPanX;
          startPanY = currentPanY;
          if (currentScale > 1) {
            isPanning = true;
          }
        }
      }

      function handleTouchMove(e) {
        if (isPinching && e.touches.length === 2) {
          e.preventDefault();
          const dist = getDistance(e.touches[0], e.touches[1]);
          currentScale = Math.min(Math.max(1, startScale * (dist / startPinchDist)), 4);
          applyTransform();
        } else if (isPanning && e.touches.length === 1) {
          e.preventDefault();
          const dx = e.touches[0].clientX - touchStartX;
          const dy = e.touches[0].clientY - touchStartY;
          currentPanX = startPanX + dx;
          currentPanY = startPanY + dy;
          applyTransform();
        }
      }

      function handleTouchEnd(e) {
        if (isPinching) {
          isPinching = false;
          if (currentScale <= 1.05) resetZoom();
        } else if (!isPanning && e.changedTouches.length === 1) {
          const dx = e.changedTouches[0].clientX - touchStartX;
          const dy = e.changedTouches[0].clientY - touchStartY;
          if (currentScale === 1 && Math.abs(dx) > 45 && Math.abs(dy) < 60) {
            if (dx > 0) prevModalPhoto();
            else nextModalPhoto();
          }
        }
        isPanning = false;
      }

      function getDistance(t1, t2) {
        return Math.hypot(t2.clientX - t1.clientX, t2.clientY - t1.clientY);
      }

      // ============================================================
      // ABOUT / INFO MODAL
      // ============================================================
      function initAboutModal() {
        const infoModal = document.getElementById('info-modal');
        const openBtn = document.getElementById('info-open-btn');
        const closeBtn = document.getElementById('info-close-btn');

        openBtn?.addEventListener('click', () => {
          infoModal?.showModal();
        });

        closeBtn?.addEventListener('click', () => {
          infoModal?.close();
        });

        infoModal?.addEventListener('click', (e) => {
          if (e.target === infoModal) infoModal.close();
        });
      }

      // ============================================================
      // LIKES & COMMENTS FUNCTIONALITY
      // ============================================================
      function isPostLiked(dbId) {
        if (!dbId) return false;
        const liked = JSON.parse(localStorage.getItem('miu_liked_posts') || '[]');
        return liked.includes(dbId.toString());
      }

      function markPostAsLiked(dbId) {
        if (!dbId) return;
        const liked = JSON.parse(localStorage.getItem('miu_liked_posts') || '[]');
        if (!liked.includes(dbId.toString())) {
          liked.push(dbId.toString());
          localStorage.setItem('miu_liked_posts', JSON.stringify(liked));
        }
      }

      function triggerLikeAnimation(e) {
        if (!currentWork || !currentWork.databaseId) return;
        const dbId = currentWork.databaseId;
        if (isPostLiked(dbId)) return;

        markPostAsLiked(dbId);
        currentWork.likeCount++;
        updateWorkStatsUI();

        // Heart burst animation
        const heart = document.createElement('div');
        heart.className = 'fixed pointer-events-none z-[99999] transform -translate-x-1/2 -translate-y-1/2 animate-heart-burst';
        heart.innerHTML = `<svg viewBox="0 0 24 24" class="w-28 h-28 fill-current text-rose-500 drop-shadow-[0_0_30px_rgba(244,63,94,0.8)]"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`;
        heart.style.left = (e?.clientX || window.innerWidth / 2) + 'px';
        heart.style.top = (e?.clientY || window.innerHeight / 2) + 'px';
        document.body.appendChild(heart);
        setTimeout(() => heart.remove(), 1000);

        if (window.WP_GRAPHQL_URL) {
          fetch(window.WP_GRAPHQL_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              query: `mutation IncrementLike($postId: Int!) { incrementLike(input: {postId: $postId}) { newCount } }`,
              variables: { postId: parseInt(dbId) }
            })
          }).catch(err => console.error('Like request failed', err));
        }
      }

      function updateWorkStatsUI() {
        if (!currentWork) return;
        const likeCountEl = document.getElementById('work-like-count');
        const commentCountEl = document.getElementById('work-comment-count');
        const workLikeBtn = document.getElementById('work-like-btn');
        const isLiked = isPostLiked(currentWork.databaseId);

        if (likeCountEl) likeCountEl.textContent = (currentWork.likeCount || 0).toLocaleString();
        if (commentCountEl) commentCountEl.textContent = (currentWork.guestComments?.length || 0).toString();
        if (workLikeBtn) {
          if (isLiked) workLikeBtn.classList.add('is-liked');
          else workLikeBtn.classList.remove('is-liked');
        }
        updateModalLikeButton();
      }

      function updateModalLikeButton() {
        const modalLikeBtn = document.getElementById('modal-like-btn');
        if (!modalLikeBtn || !currentWork) return;
        const isLiked = isPostLiked(currentWork.databaseId);
        if (isLiked) {
          modalLikeBtn.classList.add('text-rose-500', 'fill-current');
          modalLikeBtn.style.color = 'var(--char-accent)';
        } else {
          modalLikeBtn.classList.remove('text-rose-500', 'fill-current');
          modalLikeBtn.style.color = '';
        }
      }

      function fetchLiveStats(postId) {
        if (!window.WP_GRAPHQL_URL || !postId) return;
        fetch(window.WP_GRAPHQL_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            query: `query GetLiveStats($postId: Int!) { liveArtworkStats(postId: $postId) { likeCount guestComments { id parentId author content date } } }`,
            variables: { postId: parseInt(postId) }
          })
        })
        .then(res => res.json())
        .then(res => {
          const stats = res?.data?.liveArtworkStats;
          if (stats && currentWork && currentWork.databaseId == postId) {
            currentWork.likeCount = stats.likeCount || 0;
            currentWork.guestComments = stats.guestComments || [];
            updateWorkStatsUI();
            renderComments();
          }
        })
        .catch(err => console.error(err));
      }

      function renderComments() {
        if (!commentList || !currentWork) return;
        const comments = currentWork.guestComments || [];
        const modalCount = document.getElementById('modal-comment-count');
        if (modalCount) modalCount.textContent = comments.length;

        if (comments.length === 0) {
          commentList.innerHTML = '<p class="text-gray-500 font-light text-center py-10">まだコメントはありません。<br/>最初のコメントを投稿しよう！</p>';
          return;
        }

        const topComments = comments.filter(c => !c.parentId || c.parentId === 0);
        commentList.innerHTML = topComments.map(c => {
          const replies = comments.filter(r => r.parentId === c.id);
          return `
            <div class="bg-white/5 border border-white/5 rounded-2xl p-3 text-xs">
              <div class="flex items-baseline justify-between mb-1.5">
                <span class="text-white font-medium">${c.author || '名無しさん'}</span>
                <span class="text-gray-500 text-[10px]">${c.date ? new Date(c.date).toLocaleDateString() : 'Just now'}</span>
              </div>
              <p class="text-gray-300 font-light leading-relaxed mb-2">${c.content}</p>
              <button class="btn-reply text-[10px] text-gray-500 hover:text-rose-400 flex items-center gap-1 outline-none" data-reply-id="${c.id}" data-reply-author="${c.author || '名無しさん'}">
                <span>↩ 返信する</span>
              </button>
              ${replies.length > 0 ? `
                <div class="space-y-2 mt-2 ml-4 border-l-2 border-rose-500/40 pl-2">
                  ${replies.map(r => `
                    <div class="bg-white/5 rounded-xl p-2">
                      <div class="flex items-baseline justify-between mb-1">
                        <span class="text-white font-medium text-[11px]">${r.author || '名無しさん'}</span>
                        <span class="text-gray-500 text-[9px]">${r.date ? new Date(r.date).toLocaleDateString() : 'Just now'}</span>
                      </div>
                      <p class="text-gray-300 font-light leading-relaxed">${r.content}</p>
                    </div>
                  `).join('')}
                </div>
              ` : ''}
            </div>
          `;
        }).join('');

        commentList.querySelectorAll('.btn-reply').forEach(btn => {
          btn.addEventListener('click', () => {
            activeReplyId = parseInt(btn.getAttribute('data-reply-id'));
            const name = btn.getAttribute('data-reply-author');
            const indicator = document.getElementById('reply-indicator');
            const nameSpan = document.getElementById('reply-indicator-name');
            if (indicator && nameSpan) {
              nameSpan.textContent = name;
              indicator.classList.remove('hidden');
              indicator.classList.add('flex');
            }
            commentContentInput?.focus();
          });
        });
      }

      function cancelReply() {
        activeReplyId = 0;
        const indicator = document.getElementById('reply-indicator');
        if (indicator) {
          indicator.classList.add('hidden');
          indicator.classList.remove('flex');
        }
      }

      function openCommentModal() {
        renderComments();
        if (commentModal && commentModalContent) {
          commentModal.showModal();
          setTimeout(() => {
            commentModalContent.style.transform = 'scale(1)';
            commentModalContent.style.opacity = '1';
          }, 10);
          commentModal.onclick = (e) => {
            if (e.target === commentModal) closeCommentModal();
          };
        }
      }

      function closeCommentModal() {
        if (commentModal && commentModalContent) {
          commentModalContent.style.transform = 'scale(0.95)';
          commentModalContent.style.opacity = '0';
          setTimeout(() => {
            commentModal.close();
            cancelReply();
          }, 250);
        }
      }

      function submitComment() {
        if (!currentWork || !currentWork.databaseId) {
          alert("エラー：作品が選択されていません。");
          return;
        }
        const author = (commentAuthorInput?.value || '').trim() || '名無しさん';
        const content = (commentContentInput?.value || '').trim();

        if (!content) {
          alert("コメントを入力してください！");
          return;
        }

        if (commentSubmitBtn) {
          commentSubmitBtn.disabled = true;
          commentSubmitBtn.textContent = '送信中...';
        }

        if (window.WP_GRAPHQL_URL) {
          fetch(window.WP_GRAPHQL_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              query: `mutation AddComment($postId: Int!, $author: String!, $content: String!, $parentId: ID) {
                createComment(input: {
                  commentOn: $postId,
                  author: $author,
                  content: $content,
                  parent: $parentId
                }) {
                  success
                  comment { id date content }
                }
              }`,
              variables: {
                postId: parseInt(currentWork.databaseId),
                author: author,
                content: content,
                parentId: activeReplyId ? String(activeReplyId) : null
              }
            })
          })
          .then(res => res.json())
          .then(res => {
            if (res?.data?.createComment?.success) {
              if (commentContentInput) commentContentInput.value = '';
              cancelReply();
              fetchLiveStats(currentWork.databaseId);
            } else {
              alert("コメントの投稿に失敗しました。時間をおいて再試行してください。");
            }
          })
          .catch(err => {
            console.error(err);
            alert("ネットワークエラーが発生しました。");
          })
          .finally(() => {
            if (commentSubmitBtn) {
              commentSubmitBtn.disabled = false;
              commentSubmitBtn.textContent = '送信';
            }
          });
        }
      }

      function initLikesAndComments() {
        document.getElementById('work-like-btn')?.addEventListener('click', (e) => triggerLikeAnimation(e));
        document.getElementById('modal-like-btn')?.addEventListener('click', (e) => triggerLikeAnimation(e));

        document.getElementById('work-comment-btn')?.addEventListener('click', openCommentModal);
        document.getElementById('modal-comment-btn')?.addEventListener('click', openCommentModal);

        document.getElementById('btn-close-comment-modal')?.addEventListener('click', closeCommentModal);
        document.getElementById('btn-cancel-reply')?.addEventListener('click', cancelReply);
        commentSubmitBtn?.addEventListener('click', submitComment);
      }

      // ============================================================
      // CUSTOM CURSOR & 3D TILT
      // ============================================================
      function initCustomCursor() {
        const cursor = document.getElementById('custom-cursor');
        if (!cursor || window.matchMedia('(pointer: coarse)').matches) return;

        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 2;
        let ringX = mouseX;
        let ringY = mouseY;

        window.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          cursor.style.left = `${mouseX}px`;
          cursor.style.top = `${mouseY}px`;
        });

        window.rebindCursorHovers = function() {
          document.querySelectorAll('button, a, .char-select-card, .work-album-card, .photo-thumb-btn, .stage-photo-wrapper').forEach(el => {
            el.addEventListener('mouseenter', () => {
              if (el.classList.contains('stage-photo-wrapper')) {
                cursor.classList.add('is-expand');
              } else {
                cursor.classList.add('is-hovering');
              }
            });
            el.addEventListener('mouseleave', () => {
              cursor.classList.remove('is-hovering', 'is-expand');
            });
          });
        };

        window.rebindCursorHovers();
      }

      function init3DTilt() {
        const tiltEl = document.querySelector('.tilt-element');
        if (!tiltEl || window.matchMedia('(pointer: coarse)').matches) return;

        tiltEl.addEventListener('mousemove', (e) => {
          const rect = tiltEl.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          const rotateX = ((y - centerY) / centerY) * -6;
          const rotateY = ((x - centerX) / centerX) * 6;

          tiltEl.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        });

        tiltEl.addEventListener('mouseleave', () => {
          tiltEl.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
        });
      }

      // ============================================================
      // EXPLORE MODE: INFINITE PHOTO STREAM MODULE
      // ============================================================
      const exploreState = {
        active: false,
        photoIndex: 0,
        currentModelId: '',
        scale: 1,
        panX: 0,
        panY: 0,
        tagsOpen: false,
        uiVisible: true,
        uiTimeout: null,
      };

      // EXPLORE DOM 要素
      const exploreViewport = document.getElementById('explore-viewport');
      const exploreCurrentImg = document.getElementById('explore-current-img');
      const exploreBlurImg = document.getElementById('explore-blur-img');
      const exploreStageArea = document.getElementById('explore-stage-area');
      const exploreImageWrapper = document.getElementById('explore-image-wrapper');
      const exploreUiOverlay = document.getElementById('explore-ui-overlay');
      const explorePrevBtn = document.getElementById('explore-prev-btn');
      const exploreNextBtn = document.getElementById('explore-next-btn');
      const exploreModelName = document.getElementById('explore-model-name');
      const exploreModelChip = document.getElementById('explore-model-chip');
      const exploreWorkTitle = document.getElementById('explore-work-title');
      const exploreIndexPill = document.getElementById('explore-index-pill');
      const exploreLikeBtn = document.getElementById('explore-like-btn');
      const exploreLikeCount = document.getElementById('explore-like-count');
      const exploreTagsBtn = document.getElementById('explore-tags-btn');
      const exploreCloseBtn = document.getElementById('explore-close-btn');

      // AI Tags Bottom Sheet DOM
      const exploreTagsSheet = document.getElementById('explore-tags-sheet');
      const sheetBackdrop = document.getElementById('explore-sheet-backdrop');
      const sheetCloseBtn = document.getElementById('sheet-close-btn');
      const sheetModelName = document.getElementById('sheet-model-name');
      const sheetWorkTitle = document.getElementById('sheet-work-title');
      const sheetTagsList = document.getElementById('sheet-tags-list');
      const sheetSummaryText = document.getElementById('sheet-summary-text');

      // ヒントオーバーレイ DOM
      const exploreHintOverlay = document.getElementById('explore-hint-overlay');
      const exploreHintOkBtn = document.getElementById('explore-hint-ok-btn');
      const exploreHintCloseTop = document.getElementById('explore-hint-close-top');

      // モード切替タブ DOM
      const modeTabGallery = document.getElementById('mode-tab-gallery');
      const modeTabExplore = document.getElementById('mode-tab-explore');

      // タッチ・ジェスチャー制御変数
      let expTouchStartX = 0;
      let expTouchStartY = 0;
      let expStartPanX = 0;
      let expStartPanY = 0;
      let expStartDist = 0;
      let expStartScale = 1;
      let expIsPinching = false;
      let expIsPanning = false;
      let expLongPressTimer = null;
      let expLastTapTime = 0;
      let expSingleTapTimer = null;
      let expWheelLock = false;

      function initExploreMode() {
        if (!exploreViewport) return;

        // モード切替タブ
        modeTabGallery?.addEventListener('click', () => switchViewMode('gallery'));
        modeTabExplore?.addEventListener('click', () => switchViewMode('explore'));

        // ヘッダー・アクション
        exploreCloseBtn?.addEventListener('click', () => switchViewMode('gallery'));
        exploreLikeBtn?.addEventListener('click', (e) => triggerExploreLike(e));
        exploreTagsBtn?.addEventListener('click', openExploreTagsSheet);

        // PC 矢印ボタン
        explorePrevBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          prevExplorePhoto();
        });
        exploreNextBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          nextExplorePhoto();
        });

        // Bottom Sheet 閉じる
        sheetBackdrop?.addEventListener('click', closeExploreTagsSheet);
        sheetCloseBtn?.addEventListener('click', closeExploreTagsSheet);

        // 操作ヒント閉じる処理 (ボタン・右上の✕・背景タップ)
        const closeExploreHint = () => {
          if (exploreHintOverlay) exploreHintOverlay.style.display = 'none';
          localStorage.setItem('miu_explore_hint_seen', 'true');
        };

        exploreHintOkBtn?.addEventListener('click', closeExploreHint);
        exploreHintCloseTop?.addEventListener('click', closeExploreHint);
        exploreHintOverlay?.addEventListener('click', (e) => {
          if (e.target === exploreHintOverlay) closeExploreHint();
        });

        // モバイルタッチジェスチャー設定
        bindExploreTouchEvents();

        // PC デスクトップ操作設定
        bindExploreDesktopEvents();

        // 初期URL確認 (?mode=explore)
        const params = new URLSearchParams(window.location.search);
        if (params.get('mode') === 'explore') {
          switchViewMode('explore', false);
        }

        // ブラウザ「戻る」「進む」履歴の監視
        window.addEventListener('popstate', () => {
          const mode = new URLSearchParams(window.location.search).get('mode');
          if (mode === 'explore') {
            if (!exploreState.active) switchViewMode('explore', false);
          } else {
            if (exploreState.active) {
              switchViewMode('gallery', false);
              showCharactersView();
              if (window.innerWidth <= 960) {
                window.scrollTo({ top: 0, behavior: 'instant' });
              }
            }
          }
        });
      }

      function switchViewMode(mode, updateHistory = true) {
        if (mode === 'explore') {
          exploreState.active = true;
          stopHeroSlider();

          modeTabGallery?.classList.remove('active');
          modeTabGallery?.setAttribute('aria-selected', 'false');
          modeTabExplore?.classList.add('active');
          modeTabExplore?.setAttribute('aria-selected', 'true');

          if (exploreViewport) exploreViewport.style.display = 'flex';

          // GALLERY表示中であればその写真を優先的に引き継ぐ
          let targetIndex = 0;
          const currentPhoto = currentPhotosInWork[currentPhotoIndex];
          if (currentPhoto) {
            const foundIdx = allPhotosFlat.findIndex(p => p.id === currentPhoto.id);
            if (foundIdx !== -1) targetIndex = foundIdx;
          } else if (currentModelId) {
            const foundIdx = allPhotosFlat.findIndex(p => p.characterId === currentModelId);
            if (foundIdx !== -1) targetIndex = foundIdx;
          }

          setExplorePhoto(targetIndex);
          checkExploreHint();

          if (updateHistory) {
            const url = new URL(window.location.href);
            url.searchParams.set('mode', 'explore');
            window.history.pushState({ mode: 'explore' }, '', url.toString());
          }
        } else {
          exploreState.active = false;
          closeExploreTagsSheet();
          resetExploreZoom();

          modeTabGallery?.classList.add('active');
          modeTabGallery?.setAttribute('aria-selected', 'true');
          modeTabExplore?.classList.remove('active');
          modeTabExplore?.setAttribute('aria-selected', 'false');

          if (exploreViewport) exploreViewport.style.display = 'none';

          if (exploreState.uiTimeout) {
            clearTimeout(exploreState.uiTimeout);
            exploreState.uiTimeout = null;
          }

          // GALLERYトップ表示中ならスライダー再開
          if (!document.body.classList.contains('is-subpage')) {
            startHeroSlider();
          }

          if (updateHistory) {
            const url = new URL(window.location.href);
            url.searchParams.delete('mode');
            window.history.pushState({ mode: 'gallery' }, '', url.toString());
          }
        }
      }

      function setExplorePhoto(index, dirX = 0, dirY = 0) {
        if (!allPhotosFlat || allPhotosFlat.length === 0) return;

        // 無限ループインデックスの計算
        const total = allPhotosFlat.length;
        const normalizedIndex = ((index % total) + total) % total;
        exploreState.photoIndex = normalizedIndex;

        const photo = allPhotosFlat[normalizedIndex];
        if (!photo) return;

        exploreState.currentModelId = photo.characterId;

        // ズーム解除
        resetExploreZoom();

        // 画像切り替えとシネマティックフェード＆スライド演出
        if (exploreCurrentImg) {
          const exitX = dirX !== 0 ? dirX * -20 : 0;
          const exitY = dirY !== 0 ? dirY * -24 : 0;
          exploreCurrentImg.style.transition = 'opacity 0.15s ease-out, transform 0.15s ease-out';
          exploreCurrentImg.style.opacity = '0.05';
          exploreCurrentImg.style.transform = `translate3d(${exitX}px, ${exitY}px, 0) scale(0.98)`;

          setTimeout(() => {
            exploreCurrentImg.src = photo.image;

            const enterX = dirX !== 0 ? dirX * 24 : 0;
            const enterY = dirY !== 0 ? dirY * 28 : 0;
            exploreCurrentImg.style.transition = 'none';
            exploreCurrentImg.style.transform = `translate3d(${enterX}px, ${enterY}px, 0) scale(0.98)`;

            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                exploreCurrentImg.style.transition = 'opacity 0.28s cubic-bezier(0.22, 1, 0.36, 1), transform 0.28s cubic-bezier(0.22, 1, 0.36, 1)';
                exploreCurrentImg.style.opacity = '1';
                exploreCurrentImg.style.transform = 'translate3d(0, 0, 0) scale(1)';
              });
            });
          }, 130);
        }

        if (exploreBlurImg) {
          exploreBlurImg.src = photo.image;
        }

        // モデル名 & キャラクターカラー
        if (exploreModelName) exploreModelName.textContent = photo.modelName || 'Miu';
        if (exploreModelChip) {
          exploreModelChip.style.backgroundColor = photo.modelColor || '#f43f5e';
          exploreModelChip.style.boxShadow = `0 0 10px ${photo.modelColor || '#f43f5e'}`;
        }
        morphCharacterColor(photo.modelColor, photo.modelRgb);

        // 作品名
        if (exploreWorkTitle) exploreWorkTitle.textContent = photo.workTitle || photo.title;

        // 作品内での写真位置 (例: 03 / 12)
        const workPhotos = allPhotosFlat.filter(p => p.workId === photo.workId);
        const currentPhotoInWorkIdx = workPhotos.findIndex(p => p.id === photo.id);
        const posInWork = currentPhotoInWorkIdx !== -1 ? currentPhotoInWorkIdx + 1 : 1;
        const totalInWork = workPhotos.length > 0 ? workPhotos.length : 1;
        if (exploreIndexPill) {
          exploreIndexPill.textContent = `${String(posInWork).padStart(2, '0')} / ${String(totalInWork).padStart(2, '0')}`;
        }

        // Like状態の更新
        updateExploreLikeUI(photo);

        // プリロード
        preloadExploreImages(normalizedIndex);

        // UI表示タイマー
        kickExploreUiTimer();
      }

      function nextExplorePhoto() {
        setExplorePhoto(exploreState.photoIndex + 1, 1, 0);
      }

      function prevExplorePhoto() {
        setExplorePhoto(exploreState.photoIndex - 1, -1, 0);
      }

      function nextExploreModel() {
        if (!galleryData || galleryData.length === 0) return;
        const currentModelIdx = galleryData.findIndex(m => m.id === exploreState.currentModelId);
        const nextModelIdx = (currentModelIdx + 1) % galleryData.length;
        const nextModel = galleryData[nextModelIdx];
        if (!nextModel) return;

        const targetPhotoIdx = allPhotosFlat.findIndex(p => p.characterId === nextModel.id);
        if (targetPhotoIdx !== -1) {
          setExplorePhoto(targetPhotoIdx, 0, 1);
        }
      }

      function prevExploreModel() {
        if (!galleryData || galleryData.length === 0) return;
        const currentModelIdx = galleryData.findIndex(m => m.id === exploreState.currentModelId);
        const prevModelIdx = (currentModelIdx - 1 + galleryData.length) % galleryData.length;
        const prevModel = galleryData[prevModelIdx];
        if (!prevModel) return;

        const targetPhotoIdx = allPhotosFlat.findIndex(p => p.characterId === prevModel.id);
        if (targetPhotoIdx !== -1) {
          setExplorePhoto(targetPhotoIdx, 0, -1);
        }
      }

      function preloadExploreImages(currIdx) {
        if (!allPhotosFlat || allPhotosFlat.length === 0) return;
        const total = allPhotosFlat.length;
        const nextIdx = (currIdx + 1) % total;
        const prevIdx = (currIdx - 1 + total) % total;

        const preload = (url) => {
          if (!url) return;
          const img = new Image();
          img.src = url;
        };

        preload(allPhotosFlat[nextIdx]?.image);
        preload(allPhotosFlat[prevIdx]?.image);

        // 次モデルの先頭写真もプリロード
        const currentModelIdx = galleryData.findIndex(m => m.id === exploreState.currentModelId);
        if (currentModelIdx !== -1) {
          const nextModel = galleryData[(currentModelIdx + 1) % galleryData.length];
          const nextModelPhoto = allPhotosFlat.find(p => p.characterId === nextModel?.id);
          if (nextModelPhoto) preload(nextModelPhoto.image);
        }
      }

      function updateExploreLikeUI(photo) {
        if (!exploreLikeBtn || !photo) return;
        const isLiked = isPostLiked(photo.databaseId);
        exploreLikeBtn.classList.toggle('is-liked', isLiked);

        // 作品全体のLike数を反映
        const model = galleryData.find(m => m.id === photo.characterId);
        const work = model?.works.find(w => w.id === photo.workId);
        if (exploreLikeCount && work) {
          exploreLikeCount.textContent = (work.likeCount || 0).toLocaleString();
        }
      }

      function triggerExploreLike(e) {
        const photo = allPhotosFlat[exploreState.photoIndex];
        if (!photo || !photo.databaseId) return;

        const model = galleryData.find(m => m.id === photo.characterId);
        const work = model?.works.find(w => w.id === photo.workId);

        if (!isPostLiked(photo.databaseId)) {
          markPostAsLiked(photo.databaseId);
          if (work) work.likeCount = (work.likeCount || 0) + 1;
        }

        updateExploreLikeUI(photo);
        updateWorkStatsUI();

        // ハートバーストアニメーション
        const heart = document.createElement('div');
        heart.className = 'fixed pointer-events-none z-[99999] transform -translate-x-1/2 -translate-y-1/2 animate-heart-burst';
        heart.innerHTML = `<svg viewBox="0 0 24 24" class="w-28 h-28 fill-current text-rose-500 drop-shadow-[0_0_30px_rgba(244,63,94,0.85)]"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`;
        heart.style.left = (e?.clientX || window.innerWidth / 2) + 'px';
        heart.style.top = (e?.clientY || window.innerHeight / 2) + 'px';
        document.body.appendChild(heart);
        setTimeout(() => heart.remove(), 1000);

        // バックエンド GraphQL 同期
        if (window.WP_GRAPHQL_URL) {
          fetch(window.WP_GRAPHQL_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              query: `mutation IncrementLike($postId: Int!) { incrementLike(input: {postId: $postId}) { newCount } }`,
              variables: { postId: parseInt(photo.databaseId) }
            })
          }).catch(err => console.error('Explore like failed', err));
        }
      }

      function openExploreTagsSheet() {
        const photo = allPhotosFlat[exploreState.photoIndex];
        if (!photo || !exploreTagsSheet) return;

        if (sheetModelName) sheetModelName.textContent = photo.modelName || '';
        if (sheetWorkTitle) sheetWorkTitle.textContent = photo.workTitle || photo.title || '';

        // AI Tags
        if (sheetTagsList) {
          const tags = Array.isArray(photo.aiTags) && photo.aiTags.length > 0 ? photo.aiTags : [];
          if (tags.length > 0) {
            sheetTagsList.innerHTML = tags.map(tag => `
              <span class="explore-tag-item">#${tag}</span>
            `).join('');
          } else {
            sheetTagsList.innerHTML = '<span class="text-gray-500 text-xs font-light">タグ情報はありません</span>';
          }
        }

        // AI Summary
        if (sheetSummaryText) {
          sheetSummaryText.textContent = photo.aiSummary && photo.aiSummary.trim() !== ''
            ? photo.aiSummary
            : 'タグ情報はありません';
        }

        exploreTagsSheet.classList.add('is-open');
        exploreState.tagsOpen = true;
      }

      function closeExploreTagsSheet() {
        if (!exploreTagsSheet) return;
        exploreTagsSheet.classList.remove('is-open');
        exploreState.tagsOpen = false;
      }

      function resetExploreZoom() {
        exploreState.scale = 1;
        exploreState.panX = 0;
        exploreState.panY = 0;
        applyExploreTransform();
      }

      function applyExploreTransform() {
        if (exploreImageWrapper) {
          exploreImageWrapper.style.transform = `translate3d(${exploreState.panX}px, ${exploreState.panY}px, 0) scale(${exploreState.scale})`;
        }
      }

      function toggleExploreUi() {
        exploreState.uiVisible = !exploreState.uiVisible;
        if (exploreUiOverlay) {
          exploreUiOverlay.classList.toggle('ui-hidden', !exploreState.uiVisible);
        }
        if (exploreState.uiVisible) {
          kickExploreUiTimer();
        }
      }

      function kickExploreUiTimer() {
        if (exploreState.uiTimeout) clearTimeout(exploreState.uiTimeout);
        exploreState.uiVisible = true;
        if (exploreUiOverlay) exploreUiOverlay.classList.remove('ui-hidden');

        exploreState.uiTimeout = setTimeout(() => {
          if (exploreState.active && !exploreState.tagsOpen && exploreState.scale === 1) {
            exploreState.uiVisible = false;
            if (exploreUiOverlay) exploreUiOverlay.classList.add('ui-hidden');
          }
        }, 3600);
      }

      function checkExploreHint() {
        const seen = localStorage.getItem('miu_explore_hint_seen');
        if (!seen && exploreHintOverlay) {
          exploreHintOverlay.style.display = 'flex';
        }
      }

      function bindExploreTouchEvents() {
        if (!exploreStageArea) return;

        exploreStageArea.addEventListener('touchstart', (e) => {
          if (!exploreState.active) return;
          kickExploreUiTimer();

          if (e.touches.length === 2) {
            if (expLongPressTimer) clearTimeout(expLongPressTimer);
            expIsPinching = true;
            expStartDist = getDistance(e.touches[0], e.touches[1]);
            expStartScale = exploreState.scale;
          } else if (e.touches.length === 1) {
            expTouchStartX = e.touches[0].clientX;
            expTouchStartY = e.touches[0].clientY;
            expStartPanX = exploreState.panX;
            expStartPanY = exploreState.panY;

            if (exploreState.scale > 1) {
              expIsPanning = true;
            }

            // 長押し判定 (550ms)
            if (expLongPressTimer) clearTimeout(expLongPressTimer);
            expLongPressTimer = setTimeout(() => {
              if (exploreState.scale === 1 && !expIsPanning && !expIsPinching) {
                openExploreTagsSheet();
              }
            }, 550);
          }
        }, { passive: false });

        exploreStageArea.addEventListener('touchmove', (e) => {
          if (!exploreState.active) return;

          if (expIsPinching && e.touches.length === 2) {
            e.preventDefault();
            const dist = getDistance(e.touches[0], e.touches[1]);
            exploreState.scale = Math.min(Math.max(1, expStartScale * (dist / expStartDist)), 4);
            applyExploreTransform();
          } else if (expIsPanning && e.touches.length === 1) {
            e.preventDefault();
            const dx = e.touches[0].clientX - expTouchStartX;
            const dy = e.touches[0].clientY - expTouchStartY;
            exploreState.panX = expStartPanX + dx;
            exploreState.panY = expStartPanY + dy;
            applyExploreTransform();
          } else if (e.touches.length === 1) {
            const dx = Math.abs(e.touches[0].clientX - expTouchStartX);
            const dy = Math.abs(e.touches[0].clientY - expTouchStartY);
            if (dx > 12 || dy > 12) {
              if (expLongPressTimer) clearTimeout(expLongPressTimer);
            }
          }
        }, { passive: false });

        exploreStageArea.addEventListener('touchend', (e) => {
          if (!exploreState.active) return;
          if (expLongPressTimer) clearTimeout(expLongPressTimer);

          if (expIsPinching) {
            expIsPinching = false;
            if (exploreState.scale <= 1.05) resetExploreZoom();
            return;
          }

          if (expIsPanning) {
            expIsPanning = false;
            return;
          }

          if (e.changedTouches.length === 1) {
            const touch = e.changedTouches[0];
            const dx = touch.clientX - expTouchStartX;
            const dy = touch.clientY - expTouchStartY;
            const absX = Math.abs(dx);
            const absY = Math.abs(dy);

            // ズーム中はスワイプ無効（パン優先）
            if (exploreState.scale === 1) {
              // 横スワイプ優先判定 (写真送り)
              if (absX > absY && absX > 40) {
                if (dx < 0) nextExplorePhoto();
                else prevExplorePhoto();
                return;
              }

              // 縦スワイプ判定 (モデル切り替え)
              if (absY > absX && absY > 50) {
                if (dy < 0) nextExploreModel();
                else prevExploreModel();
                return;
              }

              // タップ判定 (移動が微小な場合)
              if (absX < 12 && absY < 12) {
                const now = Date.now();
                if (now - expLastTapTime < 280) {
                  // ダブルタップ: Like
                  if (expSingleTapTimer) clearTimeout(expSingleTapTimer);
                  expLastTapTime = 0;
                  triggerExploreLike({ clientX: touch.clientX, clientY: touch.clientY });
                } else {
                  // シングルタップ待機: UI表示/非表示トグル
                  expLastTapTime = now;
                  expSingleTapTimer = setTimeout(() => {
                    toggleExploreUi();
                  }, 280);
                }
              }
            }
          }
        }, { passive: true });
      }

      function bindExploreDesktopEvents() {
        window.addEventListener('keydown', (e) => {
          if (!exploreState.active) return;

          // Esc
          if (e.key === 'Escape') {
            e.preventDefault();
            if (exploreHintOverlay && exploreHintOverlay.style.display !== 'none') {
              exploreHintOverlay.style.display = 'none';
              localStorage.setItem('miu_explore_hint_seen', 'true');
              return;
            }
            if (exploreState.tagsOpen) {
              closeExploreTagsSheet();
            } else {
              switchViewMode('gallery');
            }
            return;
          }

          // タグ開閉
          if (e.key === 't' || e.key === 'T') {
            e.preventDefault();
            if (exploreState.tagsOpen) closeExploreTagsSheet();
            else openExploreTagsSheet();
            return;
          }

          // Like
          if (e.key === 'f' || e.key === 'F') {
            e.preventDefault();
            triggerExploreLike();
            return;
          }

          // 左右キー (写真)
          if (e.key === 'ArrowRight') {
            e.preventDefault();
            nextExplorePhoto();
            return;
          }
          if (e.key === 'ArrowLeft') {
            e.preventDefault();
            prevExplorePhoto();
            return;
          }

          // 上下キー (モデル)
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            nextExploreModel();
            return;
          }
          if (e.key === 'ArrowUp') {
            e.preventDefault();
            prevExploreModel();
            return;
          }
        });

        // マウスホイール (350ms クールダウン)
        exploreViewport?.addEventListener('wheel', (e) => {
          if (!exploreState.active || expWheelLock || exploreState.tagsOpen) return;
          expWheelLock = true;
          setTimeout(() => { expWheelLock = false; }, 350);

          if (e.deltaY > 0) nextExplorePhoto();
          else if (e.deltaY < 0) prevExplorePhoto();
        }, { passive: true });

        // PC ダブルクリック (Like)
        exploreStageArea?.addEventListener('dblclick', (e) => {
          if (!exploreState.active) return;
          triggerExploreLike(e);
        });

        // マウス移動でUI再表示
        exploreViewport?.addEventListener('mousemove', () => {
          if (!exploreState.active) return;
          kickExploreUiTimer();
        });
      }

      function initKeyboardShortcuts() {
        window.addEventListener('keydown', (e) => {
          if (modal?.open || commentModal?.open || exploreState.active) return;

          if (e.key === 'Escape') {
            const isPhotos = document.body.classList.contains('is-photos-view');
            const isSubpage = document.body.classList.contains('is-subpage');
            if (isPhotos) showWorksView(currentModelId);
            else if (isSubpage) showCharactersView();
          }
        });
      }

      // 起動
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initApp);
      } else {
        initApp();
      }
    })();
  </script>
</body>
</html>
