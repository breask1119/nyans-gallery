  <!-- ============================================================
       APP MAIN: 100dvh VIEWPORT APP
       PC: Left (70%) Main Visual + Right (30%) 3-Tier Navigation Panel
       Mobile: Top Main Visual + Bottom Interactive Deck
       ============================================================ -->
  <main class="app-viewport-container">

    <!-- LEFT / TOP PANE: DYNAMIC MAIN VISUAL STAGE -->
    <section class="main-visual-stage" id="main-visual-stage" aria-label="メイン写真ビュー">
      
      <!-- Background Ambient Blur Image Layer -->
      <div class="stage-blur-layer" id="stage-blur-layer">
        <img id="stage-blur-img" src={heroSliderList[0]?.image || placeholderImg} alt="" aria-hidden="true">
      </div>

      <!-- Main High-Res Photo Container (Click to expand) -->
      <div class="stage-photo-wrapper tilt-element" id="stage-photo-wrapper" data-tilt-intensity="6">
        <img id="main-stage-img" src={heroSliderList[0]?.image || placeholderImg} alt="Featured Photo" class="main-stage-photo" fetchpriority="high">
        
        <!-- Expand Prompt Overlay -->
        <div class="photo-expand-prompt">
          <span class="prompt-pill">
            <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i>
            <span class="pc-text">{heroSliderList[0]?.isLatestPost ? `VIEW "${heroSliderList[0]?.title}"` : 'CLICK TO VIEW ALBUM'}</span>
            <span class="sp-text">{heroSliderList[0]?.isLatestPost ? `VIEW "${heroSliderList[0]?.title}"` : 'TAP TO VIEW ALBUM'}</span>
          </span>
        </div>
      </div>

      <!-- Character Name Glassmorphic Badge Capsule -->
      <div class="stage-title-overlay" id="stage-title-overlay">
        <div class="stage-char-badge" id="stage-char-badge">
          <span class="stage-color-chip" id="stage-color-chip" style={`background-color: ${heroSliderList[0]?.color || '#0b0b0b'};`}></span>
          <h1 class="stage-badge-text" id="stage-badge-name">
            {heroSliderList[0]?.isLatestPost
              ? `NEW: ${heroSliderList[0]?.title}`
              : getRomajiName(heroSliderList[0]?.modelName || "美羽 / Miu", heroSliderList[0]?.characterId)}
          </h1>
        </div>
      </div>

      <!-- Stage Slider Dots (トップページ自動スライダー時のインジケーター) -->
      <div class="stage-slider-dots active" id="stage-slider-dots" aria-hidden="true"></div>

    </section>

    <!-- RIGHT / BOTTOM PANE: 3-TIER CONTENT & NAVIGATION PANEL -->
    <aside class="side-content-panel" id="side-content-panel" aria-label="モデル＆作品ナビゲーション">
      
      <!-- TIER 1: CHARACTERS LIST (Initial State) -->
      <div class="panel-view-section active" id="view-characters">
        <div class="panel-view-header">
          <div>
            <h2 class="panel-heading">MODELS & CHARACTERS</h2>
            <p class="panel-subtext">モデルを選択して作品アルバムへ</p>
          </div>
        </div>

        <div class="characters-grid-list" id="characters-grid-list">
          {formattedGalleryData.map((c: any) => (
            <button class="char-select-card" data-char-id={c.id} aria-label={`${c.name} の作品アルバムを見る`}>
              <div class="char-card-media">
                <img src={c.avatar} alt={c.name} loading="lazy" referrerpolicy="no-referrer">
                <div class="char-card-color-overlay" style={`background-color: ${c.color};`}></div>
              </div>
              <div class="char-card-caption">
                <div class="char-card-name" set:html={formatTitleHtml(c.name)}></div>
                <div class="char-card-works-count">{c.works.length} Works</div>
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- TIER 2: WORKS LIST OF SELECTED MODEL -->
      <div class="panel-view-section" id="view-works">
        
        <!-- Back Navigation to Models -->
        <div class="panel-nav-bar">
          <button class="panel-back-btn" id="btn-back-to-characters" aria-label="モデル一覧に戻る">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            <span>MODELS & CHARACTERS</span>
          </button>
        </div>

        <!-- Selected Model Header Summary Card -->
        <div class="active-model-card" id="active-model-summary">
          <div class="model-card-top">
            <div class="model-avatar-circle">
              <img id="active-model-avatar" src={formattedGalleryData[0]?.avatar} alt="Model Avatar">
            </div>
            <div class="model-text-meta">
              <h3 class="model-card-name" id="active-model-name" set:html={formatTitleHtml(formattedGalleryData[0]?.name)}></h3>
            </div>
            <div class="model-works-count-pill" id="active-model-works-count">0 Works</div>
          </div>
          <div class="model-bio-section" id="active-model-bio-section">
            <div class="model-card-bio" id="active-model-bio" set:html={formattedGalleryData[0]?.bio || ''}></div>
          </div>
        </div>

        <!-- Works / Albums List -->
        <div class="section-sub-heading">
          <span>WORKS & ALBUMS</span>
          <span class="sub-hint">作品を選択</span>
        </div>
        <div class="works-albums-list" id="works-albums-list">
          <!-- Injected dynamically by JS -->
        </div>

      </div>

      <!-- TIER 3: PHOTOS THUMBNAIL GRID (Inside Selected Work) -->
      <div class="panel-view-section" id="view-photos">
        
        <!-- Back Navigation to Works List -->
        <div class="panel-nav-bar">
          <button class="panel-back-btn" id="btn-back-to-works" aria-label="作品一覧に戻る">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            <span id="btn-back-works-label">WORKS LIST</span>
          </button>
        </div>

        <!-- Active Work Header Card with Like & Comment Buttons -->
        <div class="active-work-summary-card">
          <div class="work-summary-top">
            <h3 class="work-summary-title" id="active-work-title">Work Title</h3>
            <div class="work-action-group">
              <!-- Like Button -->
              <button id="work-like-btn" class="action-pill-btn" aria-label="いいね">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
                </svg>
                <span id="work-like-count">0</span>
              </button>

              <!-- Comment Button -->
              <button id="work-comment-btn" class="action-pill-btn" aria-label="コメントを見る">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                <span id="work-comment-count">0</span>
              </button>

              <div class="work-photos-count-badge" id="active-work-photos-count">0 Photos</div>
            </div>
          </div>
        </div>

        <!-- Thumbnails Grid inside the Work -->
        <div class="section-sub-heading">
          <span>PHOTOS IN WORK</span>
          <span class="sub-hint">タップで大画面切替</span>
        </div>
        <div class="photos-thumbnails-grid" id="photos-thumbnails-grid">
          <!-- Injected dynamically by JS -->
        </div>

        <!-- Patreon Banner in Detail View -->
        <a href="https://www.patreon.com/cw/u73055670?utm_medium=unknown&utm_source=join_link&utm_campaign=creatorshare_creator&utm_content=copyLink" target="_blank" rel="noopener noreferrer" class="patreon-detail-banner" aria-label="Patreonで限定作品を見る">
          <div class="flex items-center gap-2.5">
            <svg class="w-5 h-5 text-[#ff424d] fill-current shrink-0" viewBox="0 0 1080 1080">
              <path d="M1033.05,324.45c-0.19-137.9-107.59-250.92-233.6-291.7c-156.48-50.64-362.86-43.3-512.28,27.2 C106.07,145.41,49.18,332.61,47.06,519.31c-1.74,153.5,13.58,557.79,241.62,560.67c169.44,2.15,194.67-216.18,273.07-321.33 c55.78-74.81,127.6-95.94,216.01-117.82C929.71,603.22,1033.27,483.3,1033.05,324.45z"></path>
            </svg>
            <div>
              <div class="text-white text-xs font-medium">Patreon Exclusive Collection</div>
              <div class="text-gray-400 text-[10px]">高解像度・未公開カットをPatreonで公開中</div>
            </div>
          </div>
          <span class="text-[#ff424d] text-xs font-semibold shrink-0">JOIN →</span>
        </a>

      </div>

    </aside>

  </main>

  <!-- ============================================================
       EXPLORE VIEWPORT: INFINITE CINEMATIC GALLERY
       Full immersion infinite photo stream with gesture navigation
       ============================================================ -->
  <section id="explore-viewport" class="explore-viewport" aria-label="EXPLORE 無限ギャラリー" style="display: none;">
    <!-- Dynamic Ambient Blur Background Layer -->
    <div class="explore-blur-backdrop" id="explore-blur-backdrop">
      <img id="explore-blur-img" src="" alt="" aria-hidden="true" />
    </div>

    <!-- Main Visual Stage (Pan, Pinch, Swipe Container) -->
    <div class="explore-stage-area" id="explore-stage-area">
      <div class="explore-image-wrapper" id="explore-image-wrapper">
        <img id="explore-current-img" class="explore-current-img" src="" alt="Explore Photography" draggable="false" />
      </div>

      <!-- PC Navigation Chevrons -->
      <button class="explore-nav-btn prev" id="explore-prev-btn" aria-label="前の写真 (←)">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <span>PREV</span>
      </button>
      <button class="explore-nav-btn next" id="explore-next-btn" aria-label="次の写真 (→)">
        <span>NEXT</span>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

    <!-- Overlay UI Controls (Auto fade-out after inactivity) -->
    <div class="explore-ui-overlay" id="explore-ui-overlay">
      <!-- Top Utility Header -->
      <header class="explore-header">
        <div class="explore-model-meta" id="explore-model-meta">
          <span class="explore-model-chip" id="explore-model-chip"></span>
          <span class="explore-model-name" id="explore-model-name">美羽 / Miu</span>
        </div>

        <div class="explore-actions">
          <!-- Like Button -->
          <button id="explore-like-btn" class="explore-btn-pill" aria-label="作品をお気に入り / Like">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
            </svg>
            <span id="explore-like-count">0</span>
          </button>

          <!-- AI Tags Button -->
          <button id="explore-tags-btn" class="explore-btn-pill" aria-label="AIタグ・作品詳細 (T)">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
              <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
            <span>タグ</span>
          </button>

          <!-- Back to GALLERY Mode -->
          <button id="explore-close-btn" class="explore-btn-pill explore-close" aria-label="ギャラリーモードに戻る (Esc)">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
            <span>ギャラリー</span>
          </button>
        </div>
      </header>

      <!-- Bottom Information Footer -->
      <footer class="explore-footer">
        <div class="explore-work-info">
          <h2 class="explore-work-title" id="explore-work-title">Work Title</h2>
          <div class="explore-index-pill" id="explore-index-pill">01 / 12</div>
        </div>
        <div class="explore-model-nav-hint">
          <span>↕ モデル切替</span>
        </div>
      </footer>
    </div>

    <!-- AI Tags & Summary Bottom Sheet -->
    <div class="explore-tags-sheet" id="explore-tags-sheet" aria-hidden="true">
      <div class="explore-sheet-backdrop" id="explore-sheet-backdrop"></div>
      <div class="explore-sheet-panel" id="explore-sheet-panel">
        <div class="explore-sheet-drag-handle"></div>
        <div class="explore-sheet-header">
          <div>
            <div class="explore-sheet-model" id="sheet-model-name">美羽 / Miu</div>
            <h3 class="explore-sheet-work" id="sheet-work-title">Work Title</h3>
          </div>
          <button class="explore-sheet-close" id="sheet-close-btn" aria-label="閉じる">✕</button>
        </div>

        <div class="explore-sheet-content">
          <div class="explore-sheet-section">
            <h4>AI TAGS</h4>
            <div class="explore-sheet-tags" id="sheet-tags-list">
              <!-- Dynamically rendered -->
            </div>
          </div>

          <div class="explore-sheet-section">
            <h4>AI SUMMARY</h4>
            <p class="explore-sheet-summary" id="sheet-summary-text">タグ情報はありません</p>
          </div>
        </div>
      </div>
    </div>

    <!-- First-Time Exploration Gesture Hint -->
    <div class="explore-hint-overlay" id="explore-hint-overlay" style="display: none;">
      <div class="explore-hint-box">
        <div class="explore-hint-topbar">
          <h3 class="explore-hint-title">無限モードの操作ガイド</h3>
          <button class="explore-hint-close-top" id="explore-hint-close-top" aria-label="閉じる">✕</button>
        </div>
        <!-- Smartphone Instructions -->
        <div class="explore-hint-grid sp-hint">
          <div class="hint-item"><span class="hint-icon">← →</span><span>写真をめくる（無限ループ）</span></div>
          <div class="hint-item"><span class="hint-icon">↑ ↓</span><span>モデル切替（縦スワイプ）</span></div>
          <div class="hint-item"><span class="hint-icon">♡♡</span><span>ダブルタップでいいね</span></div>
          <div class="hint-item"><span class="hint-icon">👆長押し</span><span>AIタグ・作品詳細</span></div>
          <div class="hint-item"><span class="hint-icon">1タップ</span><span>UI表示 / 非表示</span></div>
        </div>
        <!-- PC Instructions -->
        <div class="explore-hint-grid pc-hint">
          <div class="hint-item"><kbd>←</kbd> <kbd>→</kbd> / ホイール<span>写真をめくる</span></div>
          <div class="hint-item"><kbd>↑</kbd> <kbd>↓</kbd><span>モデル切替</span></div>
          <div class="hint-item"><kbd>F</kbd> / ダブルクリック<span>いいね</span></div>
          <div class="hint-item"><kbd>T</kbd><span>AIタグ・作品詳細</span></div>
          <div class="hint-item"><kbd>Esc</kbd><span>ギャラリーに戻る</span></div>
        </div>
        <button class="explore-hint-ok" id="explore-hint-ok-btn">はじめる</button>
      </div>
    </div>
  </section>

  <!-- FLOATING CHARACTER SWITCHER DOCK (Tier 2 & Tier 3) -->
  <nav id="character-floating-dock" class="character-floating-dock" aria-label="クイック・キャラクター切り替え">
    <div class="dock-inner" id="dock-inner">
